+  // The board button glows when a bot adds a task.
+  const [boardGlow, setBoardGlow] = useState(false)
+  useEffect(() => {
+    let timer = 0
+    const onAdded = () => {
+      setBoardGlow(false)
+      window.requestAnimationFrame(() => setBoardGlow(true))
+      window.clearTimeout(timer)
+      timer = window.setTimeout(() => setBoardGlow(false), 2800)
+    }
+    window.addEventListener("board-added", onAdded)
+    return () => {
+      window.removeEventListener("board-added", onAdded)
+      window.clearTimeout(timer)
+    }
+  }, [])
