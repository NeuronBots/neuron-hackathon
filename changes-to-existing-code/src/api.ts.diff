+// "Allow in this session" for a bot's outward actions (Jira, mail, GitHub): remembered for this browser tab only, per bot.
+const OUTWARD_KEY = "neuron.allowOutward."
+export function allowedThisSession(agentId: string): boolean {
+  try { return sessionStorage.getItem(OUTWARD_KEY + agentId) === "1" } catch { return false }
+}
+export function allowThisSession(agentId: string): void {
+  try { sessionStorage.setItem(OUTWARD_KEY + agentId, "1") } catch { /* private mode: it asks again next time */ }
+}
+function forgetSessionAllowances(): void {
+  try { Object.keys(sessionStorage).filter((k) => k.startsWith(OUTWARD_KEY)).forEach((k) => sessionStorage.removeItem(k)) } catch { /* nothing stored */ }
+}
+
