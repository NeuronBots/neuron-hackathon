+export interface DocItem {
+  id: string
+  title: string
+  content: string
+  tags: string[]
+  created_by?: string
+  user_id?: string
+  shared_with?: string[]
+  created_at: string
+  updated_at: string
+}
+
+export async function fetchDocs(): Promise<DocItem[]> {
+  const res = await apiFetch("/docs")
+  return handleResponse(res) as Promise<DocItem[]>
+}
+
+export async function fetchDocById(id: string): Promise<DocItem> {
+  const res = await apiFetch(`/docs/${encodeURIComponent(id)}`)
+  return handleResponse(res) as Promise<DocItem>
+}
+
+export async function createDoc(body: {
+  title: string
+  content: string
+  tags?: string[]
+  shared_with?: string[]
+}): Promise<DocItem> {
+  const res = await apiFetch("/docs", {
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify(body),
+  })
+  return handleResponse(res) as Promise<DocItem>
+}
+
+export async function shareDoc(id: string, users: string[]): Promise<DocItem> {
+  const res = await apiFetch(`/docs/${encodeURIComponent(id)}/share`, {
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify({ users }),
+  })
+  return handleResponse(res) as Promise<DocItem>
+}
+
+export async function shareDocumentFile(filename: string, users: string[]): Promise<{ filename: string; shared_with: string[] }> {
+  const res = await apiFetch(`/documents/${encodeURIComponent(filename)}/share`, {
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify({ users }),
+  })
+  return handleResponse(res) as Promise<{ filename: string; shared_with: string[] }>
+}
+
+export async function deleteDocumentFile(filename: string): Promise<void> {
+  const res = await apiFetch(`/documents/${encodeURIComponent(filename)}`, {
+    method: "DELETE",
+  })
+  if (res.status === 204) return
+  await handleResponse(res)
+}
+
+export async function deleteDoc(id: string): Promise<void> {
+  const res = await apiFetch(`/docs/${encodeURIComponent(id)}`, {
+    method: "DELETE",
+  })
+  if (res.status === 204) return
+  await handleResponse(res)
+}
