+function ConnectRow({ mark, name, hint, connected, onClick, disabled, tone }: { mark: ReactNode; name: string; hint: string; connected: boolean; onClick: () => void; disabled: boolean; tone?: string }) {
+  // One row per integration: connected ones are a quiet status, the others a button that starts the sign-in
+  const body = (
+    <>
+      <span className="setup-connect-mark" style={tone ? { color: tone } : undefined}>{mark}</span>
+      <span className="setup-connect-text">
+        <strong>{connected ? name : `Connect ${name}`}</strong>
+        <span>{disabled && !connected ? "Checking…" : hint}</span>
+      </span>
+      {connected ? (
+        <svg className="setup-connect-tick" viewBox="0 0 24 24" role="img" aria-label="Connected"><circle cx="12" cy="12" r="10" /><path d="m7.5 12.5 3 3 6-6.5" /></svg>
+      ) : disabled ? (
+        <span className="src-spinner setup-connect-wait" aria-hidden="true" />
+      ) : (
+        <svg className="setup-connect-go" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
+      )}
+    </>
+  )
