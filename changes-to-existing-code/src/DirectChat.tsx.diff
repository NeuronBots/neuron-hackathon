+  const sources = (m: DirectMessage) => (m.withheld ?? []).map((w) => w[0].toUpperCase() + w.slice(1)).join(" and ") || "this"
+  // A card for the asker: share a summary of an answer, or proceed with a write. The card answers at once and the server confirms.
+  function decide(m: DirectMessage, yes: boolean) {
+    const next = m.action ? (yes ? "running" : "cancelled") : (yes ? "sharing" : "declined")
+    setMessages((cur) => cur.map((x) => (x.id === m.id ? { ...x, share: next } : x)))
+    ;(m.action ? proceedDirect : shareDirect)(person.id, m.id, yes)
+      .then((row) => { changedAt.current = Date.now(); setMessages((cur) => cur.map((x) => (x.id === row.id ? row : x))) })
+      .catch(() => {
+        // Already decided in another tab, or the request failed: show what the server has, not a guess.
+        void fetchDirect(person.id)
+          .then((res) => {
+            changedAt.current = Date.now()
+            setMessages(res.messages)
+            if (["pending", "proceed"].includes(res.messages.find((x) => x.id === m.id)?.share ?? "")) setError("Could not send your choice.")
+          })
+          .catch(() => setError("Could not send your choice."))
+      })
+  }
+
