+        await sendDirect(targetUser.id, msgText).catch(() => {})
+      }
+
+      setShareStatus(`Shared with ${targetUser?.name || shareTarget}`)
+      window.setTimeout(() => {
+        setShareDoc(null)
+        setShareStatus("")
+        setShareTarget("")
+        setShareNote("")
+      }, 1200)
+    } catch (err) {
+      setShareStatus(`Failed to share: ${err instanceof Error ? err.message : String(err)}`)
+    } finally {
+      setShareSending(false)
+    }
+  }
+
+  async function confirmDelete() {
+    if (!deleteTarget) return
+    setDeleting(true)
+    setDeleteError("")
+    try {
+      await deleteDocumentFile(deleteTarget.filename)
+      setDocs((prev) => (prev ? prev.filter((d) => d.filename !== deleteTarget.filename) : []))
+      setDeleteTarget(null)
+    } catch (err) {
+      setDeleteError(err instanceof Error ? err.message : "Failed to delete file.")
+    } finally {
+      setDeleting(false)
+    }
+  }
+
