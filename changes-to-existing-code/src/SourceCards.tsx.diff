+function DecisionCard({ card }: { card: Extract<Card, { kind: "decision" }> }) {
+  // A question only the person can answer, in the chat where they are talking to the bot; the answer is the board's decision, so it works the same from either place
+  const [task, setTask] = useState<TaskRead | "gone" | null>(null)
+  const [text, setText] = useState("")
+  const [busy, setBusy] = useState(false)
+  const [error, setError] = useState("")
+  const batch = card.batch && card.batch.length > 1 ? card.batch : null
+  const [picked, setPicked] = useState<string[]>([]) // one answer per question of a batch
+  useEffect(() => {
+    let live = true
+    fetchTask(card.task_id).then((t) => { if (live) setTask(t) }).catch(() => { if (live) setTask("gone") })
+    return () => { live = false }
+  }, [card.task_id])
+
+  async function answer(value: string) {
+    if (!value.trim()) return
+    setBusy(true)
+    setError("")
+    try {
+      setTask(await decideTask(card.task_id, value.trim()))
+    } catch (err) {
+      setError(err instanceof Error ? err.message : "Could not send your answer.")
+    } finally {
+      setBusy(false)
+    }
+  }
+
+  const loaded = task !== null && task !== "gone" ? task : null
+  const said = loaded?.decisions.map((d) => d.text).find((t) => t.startsWith("Decision: "))?.slice("Decision: ".length) ?? ""
+  if (loaded?.status !== "decision") {
+    return (
+      <div className="dm-share src-approval" role="group" aria-label="Question">
+        <p className="dm-share-q">{batch ? batch.map((q) => q.question).join(" · ") : card.question}</p>
+        <span className="dm-share-done">{task === null ? "Checking…" : said ? `You answered: ${said}` : "No longer waiting"}</span>
+      </div>
+    )
+  }
+  if (batch) {
+    const ready = batch.every((_, i) => (picked[i] ?? "").trim())
+    return (
+      <div className="dm-share src-approval" role="group" aria-label="Decisions needed">
+        {batch.map((q, i) => (
+          <div key={i} className="src-decision-item">
+            <p className="dm-share-q src-run-head is-waiting">{q.question}</p>
+            {q.options.length > 0 && (
+              <div className="src-decision-options">
+                {q.options.map((option) => (
+                  <button key={option} type="button" className={picked[i] === option ? "dm-share-yes" : "dm-share-no"} aria-pressed={picked[i] === option} disabled={busy} onClick={() => setPicked((p) => Object.assign([...p], { [i]: option }))}>{option}</button>
+                ))}
+              </div>
+            )}
+            <input className="src-decision-input" value={picked[i] ?? ""} onChange={(e) => setPicked((p) => Object.assign([...p], { [i]: e.target.value }))} placeholder={q.options.length ? "Or answer in your own words" : "Your answer"} aria-label={`Your answer to: ${q.question}`} maxLength={2000} disabled={busy} />
+          </div>
+        ))}
+        {error && <p className="src-approval-error">{error}</p>}
+        <div className="dm-share-actions">
+          <button type="button" className="dm-share-yes" disabled={busy || !ready} onClick={() => void answer(batch.map((q, i) => `${q.question} → ${(picked[i] ?? "").trim()}`).join(" | "))}>{busy ? "Sending…" : `Send ${batch.length} answers`}</button>
+        </div>
+      </div>
+    )
+  }
+  return (
+    <div className="dm-share src-approval" role="group" aria-label="Decision needed">
+      {card.for && <p className="hint">For {card.for}</p>}
+      <p className="dm-share-q src-run-head is-waiting">{card.question}</p>
+      {error && <p className="src-approval-error">{error}</p>}
+      {card.options.length > 0 && (
+        <div className="src-decision-options">
+          {card.options.map((option, i) => (
+            <button key={option} type="button" className={i === 0 ? "dm-share-yes" : "dm-share-no"} disabled={busy} onClick={() => void answer(option)}>{option}</button>
+          ))}
+        </div>
+      )}
+      <form className="src-decision-form" onSubmit={(e) => { e.preventDefault(); void answer(text) }}>
+        <label className="answer-field">
+          <span className="answer-tag" aria-hidden="true">answer&gt;</span>
+          <input value={text} onChange={(e) => setText(e.target.value)} placeholder={card.options.length ? "Or answer in your own words" : "Your answer"} aria-label="Your answer" maxLength={2000} />
+        </label>
+        <button type="submit" className="dm-share-yes" disabled={busy || !text.trim()}>{busy ? "Sending…" : <>Send <span className="send-key" aria-hidden="true">↵</span></>}</button>
+      </form>
+    </div>
+  )
+}
