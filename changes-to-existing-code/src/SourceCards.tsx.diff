+// What Muse prints while it builds, as in a terminal. Nothing shows if the server has none (a build from before a restart).
+function BuildTerminal({ row, running }: { row: number; running: boolean }) {
+  const [lines, setLines] = useState<string[]>([])
+  const [open, setOpen] = useState(running)
+  const after = useRef(0)
+  const screen = useRef<HTMLPreElement>(null)
+  useEffect(() => {
+    let live = true
+    let timer = 0
+    const pull = async () => {
+      try {
+        const got = await fetchBuildLog(row, after.current)
+        if (!live) return
+        after.current = got.next
+        if (got.lines.length) setLines((old) => [...old, ...got.lines].slice(-500))
+        if (!got.running && !running) return  // finished, and what there was has been read
+      } catch { /* not ours, or the server is busy: try again */ }
+      if (live) timer = window.setTimeout(pull, running ? 2000 : 15000)
+    }
+    void pull()
+    return () => { live = false; window.clearTimeout(timer) }
+  }, [row, running])
+  useEffect(() => { const el = screen.current; if (el && open) el.scrollTop = el.scrollHeight }, [lines, open])
+  if (lines.length === 0) return null
+  return (
+    <div className="src-terminal">
+      <button type="button" className="src-terminal-bar" aria-expanded={open} onClick={() => setOpen((o) => !o)}>
+        <span className="src-terminal-dots" aria-hidden="true"><i /><i /><i /></span>
+        <span>muse</span>
+        <span className="src-terminal-n">{lines.length} lines {open ? "▾" : "▸"}</span>
+      </button>
+      {open && <pre ref={screen} className="src-terminal-screen" tabIndex={0} aria-label="Muse's output">{lines.map((line, i) => <div key={i}>{line}</div>)}</pre>}
+    </div>
+  )
+}
