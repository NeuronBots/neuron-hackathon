+function SessionCard({ card }: { card: Extract<Card, { kind: "session" }> }) {
+  // The first card of a session opens the panel by itself, once per browser tab; the change cards that follow only report
+  useEffect(() => {
+    if (card.title !== "Coding session" || card.status !== "running") return
+    const seen = `session-opened-${card.preview_id}`
+    try {
+      if (sessionStorage.getItem(seen)) return
+      sessionStorage.setItem(seen, "1")
+    } catch { /* private window: it opens, and may open again */ }
+    getPreview(card.preview_id).then(openPreview).catch(() => {})
+  }, [card.preview_id, card.title, card.status])
+  const running = card.status === "running"
+  return <RunCard running={running && card.title !== "Coding session"} failed={card.status === "failed"} icon={<BuildIcon />} title={`${card.title} · ${card.project}`}
+    lines={[running ? (card.title === "Coding session" ? card.stage || "Starting…" : `${card.stage || "Working"}…`) : card.status === "failed" ? card.stage || "It could not finish." : card.stage || "Done. The frame has reloaded."]}
+    action={card.title === "Coding session" ? <div className="dm-share-actions src-run-actions"><button type="button" className="dm-share-yes" onClick={() => getPreview(card.preview_id).then(openPreview).catch(() => {})}>Open the preview</button></div> : undefined} />
+}
+
+function FixButton({ repo, number }: { repo: string; number: number }) {
+  const [state, setState] = useState<"idle" | "busy" | "started">("idle")
+  const [error, setError] = useState("")
+  async function go() {
+    setState("busy")
+    setError("")
+    try {
+      await fixPrFindings(repo, number)
+      setState("started")
+    } catch (err) {
+      setError(err instanceof Error ? err.message : "Could not start the fixes.")
+      setState("idle")
+    }
+  }
+  if (state === "started") return <p className="src-approval-list src-run-note">Fixing started. Follow it below.</p>
+  return (
+    <>
+      {error && <p className="src-approval-error">{error}</p>}
+      <div className="dm-share-actions src-run-actions">
+        <button type="button" className="dm-share-yes" disabled={state === "busy"} onClick={() => void go()}>{state === "busy" ? "Starting…" : "Fix these findings"}</button>
+      </div>
+    </>
+  )
+}
