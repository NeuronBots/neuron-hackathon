+// Under a first-build plan: the person's go-ahead. Clicking it is the approval of the plan; Muse then builds it in a sandbox.
+function BuildPlanCard({ card }: { card: Extract<Card, { kind: "buildplan" }> }) {
+  const [started, setStarted] = useState(card.status === "started")
+  const [busy, setBusy] = useState(false)
+  const [error, setError] = useState("")
+
+  async function go() {
+    setBusy(true)
+    setError("")
+    try {
+      await startBuild(card.project_id, card.filename, card.row)
+      setStarted(true)
+    } catch (err) {
+      setError(err instanceof Error ? err.message : "Could not start the build.")
+    } finally {
+      setBusy(false)
+    }
+  }
+
+  return (
+    <div className="dm-share src-approval" role="group" aria-label="Build the plan">
+      <p className={`dm-share-q src-run-head ${started ? "is-done" : "is-running"}`}>{card.title || "The first-build plan"} is ready. Read it, then have Muse build it?</p>
+      <ul className="src-approval-list">
+        <li>Muse writes the code in a sandbox, using the ponytail, frontend design and single-responsibility skills, and runs it to check it works.</li>
+        <li>You get a run guide with the exact commands, the code saved in Docs, and a pull request waiting for your Allow.</li>
+      </ul>
+      {error && <p className="src-approval-error">{error}</p>}
+      {started ? (
+        <span className="dm-share-done">Build started. Follow it below.</span>
+      ) : (
+        <div className="dm-share-actions">
+          <a className="dm-share-no src-read-plan" href={`/api/documents/${encodeURIComponent(card.filename)}`} target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z M14 3v5h5 M9 13h6 M9 17h6" /></svg>Read the plan<span aria-hidden="true">↗</span></a>
+          <button type="button" className="dm-share-yes" disabled={busy} onClick={() => void go()}>{busy ? "Starting…" : "Approve and build"}</button>
+        </div>
+      )}
+    </div>
+  )
+}
