+      </div>
+    )
+  }
+  if (card.kind === "session") return <SessionCard card={card} />
+  if (card.kind === "prfix") {
+    const running = card.status === "running"
+    const failed = card.status === "failed"
+    const outcome = running ? `${card.stage || "Starting"}…`
+      : failed ? card.reason || "It could not finish."
