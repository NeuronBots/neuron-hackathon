+function RunCard({ running, failed, icon, title, lines, link, action }: { running: boolean; failed?: boolean; icon: ReactNode; title: string; lines: string[]; link?: { href: string; text: string }; action?: ReactNode }) {
+  // A code bot's long job (PR review, wiki, first build): the same glass card as the access question, always open, with what it is doing as the last line
+  const [first, ...rest] = lines.filter(Boolean)
+  return (
+    <div className={`dm-share src-run${failed ? " src-run-failed" : ""}`} role="group" aria-label={title}>
+      <p className="dm-share-q src-run-head">
+        {running ? <span className="src-spinner" role="status" aria-label="In progress" /> : icon}
+        <span>{title}</span>
+      </p>
+      {rest.length > 0 && <ul className="src-approval-list">{rest.map((line, i) => <li key={i}>{line}</li>)}</ul>}
+      {action}
+      <span className="dm-share-done">{first}{link && <> · <a href={safe(link.href)} target="_blank" rel="noopener noreferrer">{link.text}</a></>}</span>
+    </div>
+  )
+}
