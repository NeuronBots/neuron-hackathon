+// Under a first-build plan: the person's go-ahead. Clicking it is the approval of the plan; Muse then builds it in a sandbox.
+function BuildPlanCard({ card }: { card: Extract<Card, { kind: "buildplan" }> }) {
+  const [started, setStarted] = useState(card.status === "started")
+  const [busy, setBusy] = useState(false)
+  const [error, setError] = useState("")
+
+  async function go() {
+    setBusy(true)
+    setError("")
+    try {
+      await startBuild(card.project_id, card.filename, card.row)
+      setStarted(true)
+    } catch (err) {
+      setError(err instanceof Error ? err.message : "Could not start the build.")
+    } finally {
+      setBusy(false)
+    }
+  }
+
+  return (
+    <div className="dm-share src-approval" role="group" aria-label="Build the plan">
+      <p className="dm-share-q">{card.title || "The first-build plan"} is ready. Read it, then have Muse build it?</p>
+      <ul className="src-approval-list">
+        <li>Muse writes the code in a sandbox, using the ponytail, frontend design and single-responsibility skills, and runs it to check it works.</li>
+        <li>You get a run guide with the exact commands, the code saved in Docs, and a pull request waiting for your Allow.</li>
+      </ul>
+      {error && <p className="src-approval-error">{error}</p>}
+      {started ? (
+        <span className="dm-share-done">Build started. Follow it below.</span>
+      ) : (
+        <div className="dm-share-actions">
+          <a className="dm-share-no" href={`/api/documents/${encodeURIComponent(card.filename)}`} target="_blank" rel="noopener noreferrer" style={{ textAlign: "center", lineHeight: "36px", textDecoration: "none" }}>Read the plan</a>
+          <button type="button" className="dm-share-yes" disabled={busy} onClick={() => void go()}>{busy ? "Starting…" : "Approve and build"}</button>
+        </div>
+      )}
+    </div>
+  )
+}
+
+// What the server wrote for a person to read: a line, one "• action" per request, then every request's full details.
+function readAsk(text: string, fallback: string): { items: string[]; rest: string } {
+  const lines = text.split("\n")
+  const items: string[] = []
+  for (let i = 1; i < lines.length && lines[i].startsWith("• "); i++) items.push(lines[i].slice(2))
+  const rest = text.split(/exactly as written\.\n\n/)[1] ?? ""
+  return items.length ? { items, rest } : { items: [fallback], rest: text }
+}
+
+// A bot may not act outside the app (Jira, mail, GitHub) until a person allows it. The card is that question, in the bot's chat, in the
+// same style as the access question in a shared chat. Several requests from one turn arrive as one card with one answer.
+// With a person in the chat there are three answers; for a bot working on its own, two.
+function ApprovalCard({ card }: { card: Extract<Card, { kind: "approval" }> }) {
+  const [task, setTask] = useState<TaskRead | null | "gone">(null)
+  const [busy, setBusy] = useState(false)
+  const [error, setError] = useState("")
+  useEffect(() => {
+    let live = true
+    fetchTask(card.task_id).then((t) => { if (live) setTask(t) }).catch(() => { if (live) setTask("gone") })
+    return () => { live = false }
+  }, [card.task_id])
+
+  async function answer(text: "Approved" | "Approved for this session" | "Declined") {
+    setBusy(true)
+    setError("")
+    try {
+      const next = await decideTask(card.task_id, text)
+      if (text === "Approved for this session" && card.agent_id) allowThisSession(card.agent_id)
+      setTask(next)
+    } catch (err) {
+      setError(err instanceof Error ? err.message : "Could not send your answer.")
+    } finally {
+      setBusy(false)
+    }
+  }
+
+  const loaded = task !== null && task !== "gone" ? task : null
+  const waiting = loaded?.status === "decision"
+  const said = loaded?.decisions.map((d) => d.text).find((t) => t.startsWith("Decision: ")) ?? ""
+  // What is shown to approve is what the server stored, not what the card says: the card's own text comes from the bot's message.
+  const { items } = readAsk(loaded?.decisions[0]?.text ?? card.detail, loaded?.title ?? card.title)
+  const many = items.length > 1
+  const who = card.name || "The bot"
+  const outcome = task === null ? "Checking…" : !said ? "No longer waiting"
+    : said.startsWith("Decision: Approved for this session") ? "Allowed for this session"
+    : said.startsWith("Decision: Approved") ? (many ? "Allowed, all done" : "Allowed, done") : "Denied, nothing was changed"
+  const list = (
+    <>
+      {items.map((item, i) => <p key={i} className="src-approval-item">{item}</p>)}
+    </>
+  )
+  if (!waiting) {
+    return (
+      <div className="dm-share src-approval" role="group" aria-label="Permission">
+        {list}
+        <span className="dm-share-done">{outcome}{many ? ` · ${items.length} actions` : ""}</span>
+      </div>
+    )
+  }
+  return (
+    <div className="dm-share src-approval" role="group" aria-label="Permission needed">
+      <p className="dm-share-q">{who} wants to do {many ? `these ${items.length} things` : "this"} as you. {card.interactive ? "Allow it?" : "Approve it?"}</p>
+      {list}
+      {error && <p className="src-approval-error">{error}</p>}
+      <div className="dm-share-actions">
+        <button type="button" className="dm-share-no" disabled={busy} onClick={() => void answer("Declined")}>{card.interactive ? "Deny" : "Decline"}</button>
+        {card.interactive && card.agent_id && (
+          <button type="button" className="dm-share-alt" disabled={busy} onClick={() => void answer("Approved for this session")}>Allow in this session</button>
+        )}
+        <button type="button" className="dm-share-yes" disabled={busy} onClick={() => void answer("Approved")}>{busy ? "Working…" : card.interactive ? "Allow" : "Approve"}</button>
+      </div>
+    </div>
+  )
+}
+
+function DecisionCard({ card }: { card: Extract<Card, { kind: "decision" }> }) {
+  // A question only the person can answer, in the chat where they are talking to the bot; the answer is the board's decision, so it works the same from either place
+  const [task, setTask] = useState<TaskRead | "gone" | null>(null)
+  const [text, setText] = useState("")
+  const [busy, setBusy] = useState(false)
+  const [error, setError] = useState("")
+  const batch = card.batch && card.batch.length > 1 ? card.batch : null
+  const [picked, setPicked] = useState<string[]>([]) // one answer per question of a batch
+  useEffect(() => {
+    let live = true
+    fetchTask(card.task_id).then((t) => { if (live) setTask(t) }).catch(() => { if (live) setTask("gone") })
+    return () => { live = false }
+  }, [card.task_id])
+
+  async function answer(value: string) {
+    if (!value.trim()) return
+    setBusy(true)
+    setError("")
+    try {
+      setTask(await decideTask(card.task_id, value.trim()))
+    } catch (err) {
+      setError(err instanceof Error ? err.message : "Could not send your answer.")
+    } finally {
+      setBusy(false)
+    }
+  }
+
+  const loaded = task !== null && task !== "gone" ? task : null
+  const said = loaded?.decisions.map((d) => d.text).find((t) => t.startsWith("Decision: "))?.slice("Decision: ".length) ?? ""
+  if (loaded?.status !== "decision") {
+    return (
+      <div className="dm-share src-approval" role="group" aria-label="Question">
+        <p className="dm-share-q">{batch ? batch.map((q) => q.question).join(" · ") : card.question}</p>
+        <span className="dm-share-done">{task === null ? "Checking…" : said ? `You answered: ${said}` : "No longer waiting"}</span>
+      </div>
+    )
+  }
+  if (batch) {
+    const ready = batch.every((_, i) => (picked[i] ?? "").trim())
+    return (
+      <div className="dm-share src-approval" role="group" aria-label="Decisions needed">
+        {batch.map((q, i) => (
+          <div key={i} className="src-decision-item">
+            <p className="dm-share-q">{q.question}</p>
+            {q.options.length > 0 && (
+              <div className="src-decision-options">
+                {q.options.map((option) => (
+                  <button key={option} type="button" className={picked[i] === option ? "dm-share-yes" : "dm-share-no"} aria-pressed={picked[i] === option} disabled={busy} onClick={() => setPicked((p) => Object.assign([...p], { [i]: option }))}>{option}</button>
+                ))}
+              </div>
+            )}
+            <input className="src-decision-input" value={picked[i] ?? ""} onChange={(e) => setPicked((p) => Object.assign([...p], { [i]: e.target.value }))} placeholder={q.options.length ? "Or answer in your own words" : "Your answer"} aria-label={`Your answer to: ${q.question}`} maxLength={2000} disabled={busy} />
+          </div>
+        ))}
+        {error && <p className="src-approval-error">{error}</p>}
+        <div className="dm-share-actions">
+          <button type="button" className="dm-share-yes" disabled={busy || !ready} onClick={() => void answer(batch.map((q, i) => `${q.question} → ${(picked[i] ?? "").trim()}`).join(" | "))}>{busy ? "Sending…" : `Send ${batch.length} answers`}</button>
+        </div>
+      </div>
+    )
+  }
+  return (
+    <div className="dm-share src-approval" role="group" aria-label="Decision needed">
+      {card.for && <p className="hint">For {card.for}</p>}
+      <p className="dm-share-q">{card.question}</p>
+      {error && <p className="src-approval-error">{error}</p>}
+      {card.options.length > 0 && (
+        <div className="src-decision-options">
+          {card.options.map((option, i) => (
+            <button key={option} type="button" className={i === 0 ? "dm-share-yes" : "dm-share-no"} disabled={busy} onClick={() => void answer(option)}>{option}</button>
+          ))}
+        </div>
+      )}
+      <form className="src-decision-form" onSubmit={(e) => { e.preventDefault(); void answer(text) }}>
+        <input value={text} onChange={(e) => setText(e.target.value)} placeholder={card.options.length ? "Or answer in your own words" : "Your answer"} aria-label="Your answer" maxLength={2000} />
+        <button type="submit" className="dm-share-yes" disabled={busy || !text.trim()}>{busy ? "Sending…" : "Send"}</button>
+      </form>
+    </div>
+  )
+}
