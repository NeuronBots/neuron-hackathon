+  // When the bot I am looking at stops typing in the background, show what it wrote. The flag is kept with the agent it was read for, so
+  // switching from a typing bot to an idle one is not mistaken for "stopped typing" (that would reload the new chat over its own load).
+  const wasTyping = useRef<{ id: string | null; typing: boolean }>({ id: null, typing: false })
+  useEffect(() => {
+    const now = !!selectedAgentId && activeTyping.agents.includes(selectedAgentId)
+    const before = wasTyping.current
+    wasTyping.current = { id: selectedAgentId, typing: now }
+    const was = before.id === selectedAgentId && before.typing
+    if (!was || now || !selectedAgentId || streamsRef.current.has(selectedAgentId)) return
+    const agentId = selectedAgentId
+    fetchAgentHistory(agentId).then((history) => {
+      if (selectedRef.current !== agentId || streamsRef.current.has(agentId)) return
+      setMessages(history.map((m, i) => ({ ...m, id: `hist-${agentId}-${i}` })))
+    }).catch(() => {})
+  }, [selectedAgentId, activeTyping])
+
+  // The chat I am looking at has to be looked at again while something is happening in it that I am not streaming: a wiki build or a PR review
+  // writes its progress into its pill in place (no new message for the poll above to see), and a bot working on its own (a plan the system gave it,
+  // a decision I answered) writes a line at a time. Every few seconds, so the pill moves and the bot's words appear as they are written.
+  const pillRunning = messages.some((m) => /"kind":\s*"(wiki|pr|build|prfix|session)"/.test(m.content) && /"status":\s*"running"/.test(m.content))
+  const botWorking = !!selectedAgentId && activeTyping.agents.includes(selectedAgentId)
+  useEffect(() => {
+    if (!selectedAgentId || !(pillRunning || botWorking)) return
+    const agentId = selectedAgentId
+    const timer = window.setInterval(() => {
+      if (streamsRef.current.has(agentId)) return
+      fetchAgentHistory(agentId).then((history) => {
+        if (selectedRef.current !== agentId || streamsRef.current.has(agentId)) return
+        setMessages(history.map((m, i) => ({ ...m, id: `hist-${agentId}-${i}` })))
+      }).catch(() => {})
+    }, 4000)
+    return () => window.clearInterval(timer)
+  }, [selectedAgentId, pillRunning, botWorking])
+
+  // Show what a bot working on its own is doing in the same place a streaming turn's status goes, and take it away when it stops.
+  const shownAuto = useRef("")
+  useEffect(() => {
+    if (!selectedAgentId || streamsRef.current.has(selectedAgentId)) return
+    if (botWorking) {
+      shownAuto.current = selectedAgentId
+      setStatusMsg(autoStatus[selectedAgentId] ?? "")
+    } else if (shownAuto.current === selectedAgentId) {
+      shownAuto.current = ""
+      setStatusMsg("")
+    }
+  }, [selectedAgentId, botWorking, autoStatus])
+
