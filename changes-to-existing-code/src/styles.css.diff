+  font-size: 0.72rem;
+  border: 1px solid rgba(91, 141, 239, 0.22);
+}
+
+/* Status States */
+.doc-status-box {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 12px;
+  padding: 32px 20px;
+  margin: 16px;
+  border-radius: 12px;
+  background: rgba(255, 255, 255, 0.02);
+  border: 1px dashed var(--line);
+  color: var(--soft);
+  text-align: center;
+  font-size: 0.9rem;
+}
+
+.doc-error {
+  border-color: rgba(224, 106, 106, 0.4);
+  color: #f08c8c;
+}
+
+.doc-error-actions {
+  display: flex;
+  gap: 8px;
+}
+
+/* Open View Pane */
+.doc-view-pane {
+  display: flex;
+  flex-direction: column;
+  flex: 2;
+  min-width: 0;
+  background: rgba(18, 22, 20, 0.7);
+  border: 1px solid rgba(255, 255, 255, 0.08);
