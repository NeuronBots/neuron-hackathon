+}
+
+/* The Goal step: Continue and Cancel sit at the bottom of the screen, and stay there when the keyboard or a long goal makes the page scroll. Cancel is red: it throws the new project away. */
+.setup:has(.setup-pinned) { display: flex; flex-direction: column; }
+.setup:has(.setup-pinned) .setup-pinned { flex: 1; }
+.setup-actions.is-cancel-last { margin-top: auto; position: sticky; bottom: 0; padding: 14px 0 4px; background: linear-gradient(to top, #000000 72%, rgba(0, 0, 0, 0)); }
+.setup-actions.is-cancel-last .btn-quiet:not(.setup-skip) { color: #ff8a80; background: rgba(255, 90, 80, 0.1); border-color: rgba(255, 90, 80, 0.45); }
+.setup-actions.is-cancel-last .btn-quiet:not(.setup-skip):hover:not(:disabled) { background: rgba(255, 90, 80, 0.18); color: #ffa39b; }
+.setup-actions.is-cancel-last .btn-quiet:not(.setup-skip):focus-visible { outline: 2px solid #ff8a80; outline-offset: 2px; }
+
+/* "Continue without a repository": a plain text button, so the footer stays short and Create / Read stay the only filled action */
+.setup-actions.is-cancel-last .setup-skip { min-height: 34px; background: none; border-color: transparent; color: #a1a1aa; font-weight: 500; }
+.setup-actions.is-cancel-last .setup-skip:hover:not(:disabled) { background: rgba(255, 255, 255, 0.08); color: #fff; }
+.setup-actions.is-cancel-last { gap: 6px; }
+.setup-actions.is-cancel-last .setup-skip { order: 0; }
+
+/* Find an existing / Create a new: a full-width segmented control. The chosen segment is a lighter thumb, not the accent colour (white on the accent blue was 3.2:1), and the choice is also shown by its heavier weight. */
+.setup-tabs { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; width: 100%; padding: 3px; box-sizing: border-box; border-radius: 12px; background: rgba(255, 255, 255, 0.07); border: 1px solid rgba(255, 255, 255, 0.1); }
+.setup-tabs button { display: inline-flex; align-items: center; justify-content: center; gap: 7px; min-height: 40px; padding: 0 10px; border-radius: 9px; color: #a1a1aa; font-size: 0.88rem; font-weight: 500; letter-spacing: -0.011em; transition: background 120ms ease-out, color 120ms ease-out; }
+.setup-tabs button svg { width: 16px; height: 16px; flex: none; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
+.setup-tabs button:hover:not(:disabled):not([aria-pressed="true"]) { background: rgba(255, 255, 255, 0.06); color: #fff; }
+.setup-tabs button[aria-pressed="true"] { background: rgba(255, 255, 255, 0.17); color: #fff; font-weight: 650; box-shadow: 0 1px 2px rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.1); }
