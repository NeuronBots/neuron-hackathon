+  gap: 8px;
+  margin-top: 4px;
+}
+
+.doc-tags-label {
+  font-size: 0.8rem;
+  color: var(--soft);
+  font-weight: 500;
+}
+
+.doc-tag {
+  display: inline-block;
+  padding: 3px 9px;
+  border-radius: 999px;
+  background: rgba(91, 141, 239, 0.15);
+  border: 1px solid rgba(91, 141, 239, 0.3);
+  color: #9cbff9;
+  font-size: 0.78rem;
+  font-weight: 500;
+}
+
+.doc-no-tags {
+  font-size: 0.8rem;
+  color: var(--soft);
+  font-style: italic;
+}
+
+.doc-open-content {
+  flex: 1;
+  overflow-y: auto;
+  padding: 24px;
+  line-height: 1.65;
+  color: var(--ink);
+}
+
+.doc-open-content p {
+  margin: 0 0 1em;
+}
+
+.doc-open-content pre {
+  background: rgba(0, 0, 0, 0.35);
+  border: 1px solid var(--line);
+  padding: 12px 14px;
+  border-radius: 8px;
+  overflow-x: auto;
+}
+
+.doc-open-content code {
+  font-family: monospace;
+}
+
+.doc-view-nav-tabs {
+  display: flex;
+  gap: 4px;
+  background: rgba(0, 0, 0, 0.2);
+  padding: 4px;
+  border-radius: 10px;
+  border: 1px solid var(--line);
+}
+
+.doc-view-nav-tab {
+  padding: 6px 14px;
+  border-radius: 6px;
+  border: none;
+  background: transparent;
+  color: var(--soft);
+  font-size: 0.85rem;
+  font-weight: 500;
+  cursor: pointer;
+  transition: all 120ms ease-out;
+}
+
+.doc-view-nav-tab.is-active {
+  background: rgba(255, 255, 255, 0.1);
+  color: #fff;
+}
+
+@media (max-width: 768px) {
+  .doc-panel-container {
+    flex-direction: column;
+    padding: 12px;
+  }
+  .doc-list-pane {
+    max-width: 100%;
+  }
+  .doc-panel-container.has-selection .doc-list-pane {
+    display: none;
+  }
+  .doc-view-pane {
+    min-height: 400px;
+  }
+}
