+
+/* A coding session is running on this bot: a "Dev" badge in its chat header (ChatView.tsx), which opens the preview panel */
+.dev-badge { display: inline-flex; align-items: center; gap: 5px; margin-left: 10px; min-height: 24px; padding: 0 8px; vertical-align: middle; border: 1px solid rgba(74, 222, 128, 0.45); border-radius: 999px; background: rgba(74, 222, 128, 0.12); color: #4ade80; font: inherit; font-size: 0.72rem; font-weight: 650; letter-spacing: 0.02em; cursor: pointer; transition: background 120ms ease-out; }
