+/* Files hub share/delete dialogs, on the shared glass .profile-modal */
+.doc-dialog { max-width: 400px; gap: 14px; }
+.doc-dialog-head h2 { font-family: var(--serif); font-size: 1.35rem; font-weight: 500; letter-spacing: -0.02em; line-height: 1.15; color: #fff; margin: 0; }
+.doc-dialog-head p { margin: 6px 0 0; font-size: 0.9rem; line-height: 1.45; color: rgba(255, 255, 255, 0.72); overflow-wrap: anywhere; }
+.doc-dialog-head b { color: #fff; font-weight: 600; }
+.doc-dialog-field { width: 100%; box-sizing: border-box; min-height: 36px; padding: 8px 12px; border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.1); border-top-color: rgba(255, 255, 255, 0.18); background: rgba(255, 255, 255, 0.05); color: #fff; font: inherit; font-size: 0.92rem; resize: vertical; }
+.doc-dialog-field::placeholder { color: rgba(255, 255, 255, 0.5); }
+.doc-dialog-field:focus { outline: 2px solid var(--stamp); outline-offset: -1px; }
+.doc-dialog-field option { color: #000; }
+.doc-dialog-actions { display: flex; align-items: center; justify-content: flex-end; gap: 8px; }
+.doc-dialog-actions .btn { min-height: 34px; }
+.doc-dialog-actions .btn-quiet { color: #fff; background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.18); }
+.doc-dialog-status { margin-right: auto; font-size: 0.82rem; color: var(--pine); }
+.doc-dialog-status.is-error { color: var(--danger); }
+@media (max-width: 860px) { .doc-dialog-actions .btn { min-height: 44px; } }
+
+/* A bot's outward action waiting for a person (Jira, mail, GitHub): the approval card in its chat, in the style of the shared-chat access question (.dm-share) */
+.dm-share.src-approval { width: min(520px, 100%); min-width: 0; box-sizing: border-box; }
+.src-approval-list { margin: 0 0 10px; padding: 0 0 0 18px; display: flex; flex-direction: column; gap: 4px; font-size: 0.84rem; line-height: 1.4; color: var(--ink); }
+.src-approval-more { margin: 0 0 10px; font-size: 0.78rem; color: var(--soft); }
+.src-approval-more summary { cursor: pointer; width: fit-content; }
+.src-approval-more pre { margin: 8px 0 0; padding: 10px 12px; max-height: 240px; overflow: auto; white-space: pre-wrap; overflow-wrap: anywhere; border-radius: 10px; background: rgba(0, 0, 0, 0.2); font: 0.76rem/1.45 var(--mono, ui-monospace, monospace); color: var(--ink); }
+.src-approval-error { margin: 0 0 8px; font-size: 0.78rem; color: var(--danger); }
+.src-approval .dm-share-actions { flex-wrap: wrap; }
+.src-approval .dm-share-actions button { flex: 1 1 auto; }
+.src-approval .dm-share-actions button:disabled { opacity: 0.6; cursor: default; }
+.dm-share-alt { background: rgba(91, 141, 239, 0.22); color: var(--ink); }
+.src-approval .dm-share-done { margin-top: 2px; }
+
+/* The wiki as a file card (SourceCards "wikidoc"): the document card's look, with links in place of buttons */
+.file-card-wiki { background: #5b6ee1; font-size: 10px; letter-spacing: 0; text-decoration: none; color: #fff; }
+.file-card a.file-card-info { text-decoration: none; color: inherit; }
+
+/* Project setup, repository step: find an existing repository, or create one */
+.setup-tabs { display: inline-flex; gap: 4px; padding: 3px; border-radius: 999px; background: rgba(255, 255, 255, 0.06); border: 1px solid var(--line); width: fit-content; }
+.setup-tabs button { min-height: 32px; padding: 0 14px; border: 0; border-radius: 999px; background: none; color: var(--soft); font: inherit; font-size: 0.86rem; font-weight: 600; cursor: pointer; }
+.setup-tabs button[aria-pressed="true"] { background: var(--stamp); color: #04121a; }
+.setup-tabs button:disabled { opacity: 0.6; cursor: default; }
+.setup-newrepo { display: flex; flex-direction: column; gap: 12px; }
+.setup-newrepo label, .setup-visibility { display: flex; flex-direction: column; gap: 6px; font-size: 0.86rem; color: var(--soft); }
+.setup-newrepo label em, .setup-visibility em { font-style: normal; opacity: 0.7; }
+.setup-newrepo input[type="text"], .setup-newrepo input:not([type]), .setup-newrepo select { min-height: 38px; padding: 6px 12px; border-radius: 10px; border: 1px solid var(--line); background: var(--field); color: var(--ink); font: inherit; }
+.setup-visibility { border: 0; margin: 0; padding: 0; }
+.setup-visibility legend { padding: 0; margin-bottom: 6px; }
+.setup-visibility label { flex-direction: row; align-items: center; gap: 8px; color: var(--ink); }
+.setup-newrepo .btn { align-self: flex-start; }
+.setup-created-actions { display: flex; flex-wrap: wrap; gap: 8px; }
+
+/* Project setup, final step: choose the coding bot (the same choice as Tweaks has) */
+.setup-coding { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 12px 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--field); }
+.setup-coding span { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
+.setup-coding b { color: var(--ink); font-size: 0.92rem; }
+.setup-coding em { font-style: normal; font-size: 0.8rem; color: var(--soft); }
+.setup-coding select { min-height: 36px; padding: 4px 10px; border-radius: 10px; border: 1px solid var(--line); background: var(--slip); color: var(--ink); font: inherit; flex: none; max-width: 45%; }
+@media (max-width: 560px) { .setup-coding { flex-direction: column; align-items: stretch; } .setup-coding select { max-width: none; } }
+
+/* Project setup, final step: start the first-build plan */
+.setup-plan { display: flex; align-items: flex-start; gap: 12px; padding: 12px 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--field); cursor: pointer; }
+.setup-plan input { margin-top: 3px; flex: none; }
