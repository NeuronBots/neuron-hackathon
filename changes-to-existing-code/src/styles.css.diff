+
+.setup-agents label { align-items: center; padding: 12px 14px; box-shadow: none; background: rgba(255, 255, 255, 0.06); border-color: rgba(255, 255, 255, 0.14); transition: background 120ms ease-out, border-color 120ms ease-out, opacity 120ms ease-out; }
