+/* The preview at full width, or at a phone's width (390 px) to check that the app is responsive */
+.preview-stage { flex: 1; display: flex; justify-content: center; min-height: 0; background: #000000; overflow: auto; }
+.preview-stage .preview-frame { flex: 1 1 auto; width: 100%; height: 100%; }
+.preview-stage.is-phone { align-items: flex-start; padding: 12px 0; }
+.preview-stage.is-phone .preview-frame { flex: none; width: min(390px, 100%); height: min(780px, 100%); border-radius: 22px; border: 6px solid #18181b; box-shadow: 0 8px 28px rgba(0, 0, 0, 0.5); box-sizing: border-box; }
+.preview-head button[aria-pressed="true"] { background: rgba(91, 141, 239, 0.35); }
+
+/* Drag the panel's left edge to resize it; the chat keeps its room (PreviewPanel.tsx) */
+.preview-resize { position: absolute; top: 0; bottom: 0; left: -5px; width: 10px; z-index: 2; cursor: col-resize; touch-action: none; }
+.preview-resize::after { content: ""; position: absolute; top: 50%; left: 3px; width: 4px; height: 44px; margin-top: -22px; border-radius: 2px; background: rgba(255, 255, 255, 0.28); opacity: 0; transition: opacity 120ms ease-out; }
