+/* Document Store & List Panel (NURN-152) */
+.doc-panel-container {
+  display: flex;
+  flex: 1;
+  min-height: 0;
+  height: 100%;
+  width: 100%;
+  max-width: 1200px;
+  margin: 0 auto;
+  gap: 20px;
+  padding: 20px;
+  box-sizing: border-box;
+}
+
+.doc-list-pane {
+  display: flex;
+  flex-direction: column;
+  flex: 1;
+  min-width: 320px;
+  max-width: 480px;
+  background: rgba(9, 9, 11, 0.7);
+  border: 1px solid rgba(255, 255, 255, 0.08);
+  border-radius: 16px;
+  overflow: hidden;
+  backdrop-filter: blur(16px);
+  -webkit-backdrop-filter: blur(16px);
+}
+
+.doc-panel-container.single-column .doc-list-pane,
+.doc-list-pane.full-width {
+  max-width: 100%;
+}
+
+.doc-list-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 16px 20px;
+  border-bottom: 1px solid var(--line);
+  gap: 12px;
+}
+
+.doc-list-title-wrap {
+  display: flex;
+  align-items: baseline;
+  gap: 8px;
+}
+
+.doc-list-title {
+  margin: 0;
+  font-family: var(--serif);
+  font-size: 1.25rem;
+  font-weight: 600;
+  color: var(--ink);
+}
+
+.doc-list-count {
+  font-size: 0.8rem;
+  color: var(--soft);
+}
+
+.doc-list-items {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  padding: 12px 16px;
+  overflow-y: auto;
+  flex: 1;
+}
+
+.doc-list-item {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  padding: 12px 14px;
+  border-radius: 12px;
+  border: 1px solid rgba(255, 255, 255, 0.06);
+  background: rgba(255, 255, 255, 0.02);
+  cursor: pointer;
+  text-align: left;
+  transition: all 120ms ease-out;
+  outline: none;
+}
+
+.doc-list-item:hover {
+  background: rgba(255, 255, 255, 0.06);
+  border-color: rgba(255, 255, 255, 0.12);
+}
+
+.doc-list-item:focus-visible {
+  border-color: var(--stamp);
+  box-shadow: 0 0 0 2px rgba(91, 141, 239, 0.3);
+}
+
+.doc-list-item.is-selected {
+  border-color: var(--stamp);
+  background: rgba(91, 141, 239, 0.08);
+}
+
+.doc-list-item-title {
+  margin: 0;
+  font-size: 0.95rem;
+  font-weight: 600;
+  color: var(--ink);
+  line-height: 1.3;
+  word-break: break-word;
+}
+
+.doc-list-item-meta {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px;
+  font-size: 0.78rem;
+  color: var(--soft);
+}
+
+.doc-list-item-date {
+  font-variant-numeric: tabular-nums;
+}
+
+.doc-tag-pill {
+  display: inline-block;
+  padding: 2px 7px;
+  border-radius: 999px;
+  background: rgba(91, 141, 239, 0.12);
+  color: #8bb2f8;
+  font-size: 0.72rem;
+  border: 1px solid rgba(91, 141, 239, 0.22);
+}
+
+/* Status States */
+.doc-status-box {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 12px;
+  padding: 32px 20px;
+  margin: 16px;
+  border-radius: 12px;
+  background: rgba(255, 255, 255, 0.02);
+  border: 1px dashed var(--line);
+  color: var(--soft);
+  text-align: center;
+  font-size: 0.9rem;
+}
+
+.doc-error {
+  border-color: rgba(224, 106, 106, 0.4);
+  color: #f08c8c;
+}
+
+.doc-error-actions {
+  display: flex;
+  gap: 8px;
+}
+
+/* Open View Pane */
+.doc-view-pane {
+  display: flex;
+  flex-direction: column;
+  flex: 2;
+  min-width: 0;
+  background: rgba(9, 9, 11, 0.7);
+  border: 1px solid rgba(255, 255, 255, 0.08);
+  border-radius: 16px;
+  overflow: hidden;
+  backdrop-filter: blur(16px);
+  -webkit-backdrop-filter: blur(16px);
+}
+
+.doc-view-placeholder {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  height: 100%;
+  color: var(--soft);
+  padding: 40px;
+  text-align: center;
+}
+
+.doc-open-header {
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+  padding: 20px 24px;
+  border-bottom: 1px solid var(--line);
+}
+
+.doc-open-top-bar {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+}
+
+.doc-open-title {
+  margin: 0;
+  font-family: var(--serif);
+  font-size: 1.6rem;
+  font-weight: 600;
+  color: #fff;
+  line-height: 1.25;
+}
+
+.doc-open-timestamps {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 8px;
+  font-size: 0.8rem;
+  color: var(--soft);
+}
+
+.doc-timestamp-sep {
+  opacity: 0.5;
+}
+
+.doc-open-tags {
+  display: flex;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: 8px;
+  margin-top: 4px;
+}
+
+.doc-tags-label {
+  font-size: 0.8rem;
+  color: var(--soft);
+  font-weight: 500;
+}
+
+.doc-tag {
+  display: inline-block;
+  padding: 3px 9px;
+  border-radius: 999px;
+  background: rgba(91, 141, 239, 0.15);
+  border: 1px solid rgba(91, 141, 239, 0.3);
+  color: #9cbff9;
+  font-size: 0.78rem;
+  font-weight: 500;
+}
+
+.doc-no-tags {
+  font-size: 0.8rem;
+  color: var(--soft);
+  font-style: italic;
+}
+
+.doc-open-content {
+  flex: 1;
+  overflow-y: auto;
+  padding: 24px;
+  line-height: 1.65;
+  color: var(--ink);
+}
+
+.doc-open-content p {
+  margin: 0 0 1em;
+}
+
+.doc-open-content pre {
+  background: rgba(0, 0, 0, 0.35);
+  border: 1px solid var(--line);
+  padding: 12px 14px;
+  border-radius: 8px;
+  overflow-x: auto;
+}
+
+.doc-open-content code {
+  font-family: monospace;
+}
+
+.doc-view-nav-tabs {
+  display: flex;
+  gap: 4px;
+  background: rgba(0, 0, 0, 0.2);
+  padding: 4px;
+  border-radius: 10px;
+  border: 1px solid var(--line);
+}
+
+.doc-view-nav-tab {
+  padding: 6px 14px;
+  border-radius: 6px;
+  border: none;
+  background: transparent;
+  color: var(--soft);
+  font-size: 0.85rem;
+  font-weight: 500;
+  cursor: pointer;
+  transition: all 120ms ease-out;
+}
+
+.doc-view-nav-tab.is-active {
+  background: rgba(255, 255, 255, 0.1);
+  color: #fff;
+}
+
+@media (max-width: 768px) {
+  .doc-panel-container {
+    flex-direction: column;
+    padding: 12px;
+  }
+  .doc-list-pane {
+    max-width: 100%;
+  }
+  .doc-panel-container.has-selection .doc-list-pane {
+    display: none;
+  }
+  .doc-view-pane {
+    min-height: 400px;
+  }
+}
