+.setup-actions .btn-primary:hover:not(:disabled) { background: #4a80e4; border-color: #4a80e4; }
+.setup-actions .btn-primary:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
+.setup-actions .btn-primary:disabled {
+  opacity: 1;
+  background: rgba(255, 255, 255, 0.08);
+  border-color: rgba(255, 255, 255, 0.12);
+  color: rgba(255, 255, 255, 0.55);
+  box-shadow: none;
