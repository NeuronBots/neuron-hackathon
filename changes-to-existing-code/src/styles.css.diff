+
+
+/* Document Store & List Panel (NURN-152) */
+.doc-panel-container {
+  display: flex;
+  flex: 1;
+  min-height: 0;
+  height: 100%;
+  width: 100%;
+  max-width: 1200px;
+  margin: 0 auto;
+  gap: 20px;
+  padding: 20px;
+  box-sizing: border-box;
+}
+
+.doc-list-pane {
+  display: flex;
+  flex-direction: column;
+  flex: 1;
+  min-width: 320px;
+  max-width: 480px;
+  background: rgba(18, 22, 20, 0.7);
+  border: 1px solid rgba(255, 255, 255, 0.08);
+  border-radius: 16px;
+  overflow: hidden;
+  backdrop-filter: blur(16px);
+  -webkit-backdrop-filter: blur(16px);
+}
+
+.doc-panel-container.single-column .doc-list-pane,
+.doc-list-pane.full-width {
+  max-width: 100%;
+}
+
+.doc-list-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 16px 20px;
+  border-bottom: 1px solid var(--line);
+  gap: 12px;
+}
+
+.doc-list-title-wrap {
+  display: flex;
+  align-items: baseline;
+  gap: 8px;
+}
+
+.doc-list-title {
+  margin: 0;
+  font-family: var(--serif);
+  font-size: 1.25rem;
+  font-weight: 600;
+  color: var(--ink);
+}
+
+.doc-list-count {
+  font-size: 0.8rem;
+  color: var(--soft);
+}
+
+.doc-list-items {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  padding: 12px 16px;
+  overflow-y: auto;
+  flex: 1;
+}
+
+.doc-list-item {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  padding: 12px 14px;
+  border-radius: 12px;
+  border: 1px solid rgba(255, 255, 255, 0.06);
+  background: rgba(255, 255, 255, 0.02);
+  cursor: pointer;
+  text-align: left;
+  transition: all 120ms ease-out;
+  outline: none;
+}
+
+.doc-list-item:hover {
+  background: rgba(255, 255, 255, 0.06);
+  border-color: rgba(255, 255, 255, 0.12);
+}
+
+.doc-list-item:focus-visible {
+  border-color: var(--stamp);
+  box-shadow: 0 0 0 2px rgba(91, 141, 239, 0.3);
+}
+
+.doc-list-item.is-selected {
+  border-color: var(--stamp);
+  background: rgba(91, 141, 239, 0.08);
+}
+
+.doc-list-item-title {
+  margin: 0;
+  font-size: 0.95rem;
+  font-weight: 600;
+  color: var(--ink);
+  line-height: 1.3;
+  word-break: break-word;
+}
+
+.doc-list-item-meta {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px;
+  font-size: 0.78rem;
+  color: var(--soft);
+}
+
+.doc-list-item-date {
+  font-variant-numeric: tabular-nums;
+}
+
+.doc-tag-pill {
+  display: inline-block;
+  padding: 2px 7px;
+  border-radius: 999px;
+  background: rgba(91, 141, 239, 0.12);
