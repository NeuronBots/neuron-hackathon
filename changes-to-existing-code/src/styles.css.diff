+
+/* the plan option is an on / off setting: a switch, not a checkbox */
+.setup-plan { align-items: center; padding: 14px; border-radius: 14px; border-color: rgba(255, 255, 255, 0.14); background: rgba(255, 255, 255, 0.06); gap: 14px; }
