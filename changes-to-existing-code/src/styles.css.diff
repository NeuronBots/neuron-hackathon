+
+/* Continue / Create on the setup steps: a deeper blue so the white label reads (4.6:1), a clear not-ready state, and a visible focus ring */
+.setup-actions .btn-primary {
+  background: #3f74d6;
+  border-radius: 999px;
+  border-color: #3f74d6;
+  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.22), 0 1px 2px rgba(0, 0, 0, 0.35);
