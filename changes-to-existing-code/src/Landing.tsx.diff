+// A price that counts up the first time it is seen (whole units, in the visitor's currency). Still, with reduced motion.
+function Price({ inr, quote, per }: { inr: number; quote: PriceQuote | null; per: string }) {
+  const box = useRef<HTMLSpanElement>(null)
+  const [value, setValue] = useState(0)
+  const [seen, setSeen] = useState(false)
+  useEffect(() => {
+    const el = box.current
+    if (!el) return
+    const watch = new IntersectionObserver(([entry]) => { if (entry.isIntersecting) { setSeen(true); watch.disconnect() } }, { threshold: 0.6 })
+    watch.observe(el)
+    return () => watch.disconnect()
+  }, [])
+  useEffect(() => {
+    if (!seen) return
+    if (inr === 0 || window.matchMedia("(prefers-reduced-motion: reduce)").matches) { setValue(inr); return }
+    let raf = 0
+    const start = performance.now()
+    const tick = (now: number) => {
+      const t = Math.min(1, (now - start) / 1200)
+      setValue(inr * (1 - (1 - t) ** 4))
+      if (t < 1) raf = requestAnimationFrame(tick)
+    }
+    raf = requestAnimationFrame(tick)
+    return () => cancelAnimationFrame(raf)
+  }, [seen, inr])
+  return <span className="lp-plan-price" ref={box}>{quote ? formatLocal(Math.round(value), quote.currency, quote.rate) : "…"}<small>{per}</small></span>
+}
