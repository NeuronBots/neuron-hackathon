+// A story told in short scenes. On a wide screen the section pins and scrolling walks through them (the motion hook
+// sends lp-pinned and lp-chapter events); on a phone, or with reduced motion, they stack and each starts when seen.
+function Chapters({ chapters, eyebrow, lines, priority }: { chapters: Chapter[]; eyebrow: string; lines: string[]; priority: number }) {
+  const root = useRef<HTMLElement>(null)
+  const [active, setActive] = useState(0)
+  const [pinned, setPinned] = useState(false)
+  const [open, setOpen] = useState(false)  // the section is pinned on screen: only then does a scene play
+  const [near, setNear] = useState(false)  // within a screen of it: the scenes load, and wait
+  const [seen, setSeen] = useState(() => chapters.map(() => false))
+  const [mounted, setMounted] = useState(() => new Set([0, 1]))
+  const current = useRef(0)
+  current.current = active
+  // When a scene finishes, the page moves on to the next chapter, unless the visitor has clicked into the demo to use it.
+  const advance = (i: number) => {
+    if (i >= chapters.length - 1) return
+    window.setTimeout(() => {
+      const el = root.current
+      if (!el || current.current !== i || el.contains(document.activeElement)) return
+      el.dispatchEvent(new CustomEvent("lp-goto", { detail: i + 1 }))
+    }, 2200)
+  }
+  useEffect(() => {
+    const el = root.current
+    if (!el) return
+    const onChapter = (e: Event) => setActive((e as CustomEvent<number>).detail)
+    const onPinned = (e: Event) => setPinned((e as CustomEvent<boolean>).detail)
+    const onOpen = (e: Event) => setOpen((e as CustomEvent<boolean>).detail)
+    el.addEventListener("lp-open", onOpen)
+    const watch = new IntersectionObserver(([entry]) => { if (entry.isIntersecting) setNear(true) }, { rootMargin: "120% 0px" })
+    watch.observe(el)
+    el.addEventListener("lp-chapter", onChapter)
+    el.addEventListener("lp-pinned", onPinned)
+    if (el.classList.contains("is-pinned")) setPinned(true)  // the motion hook may have pinned it before this listener existed
+    return () => { el.removeEventListener("lp-chapter", onChapter); el.removeEventListener("lp-pinned", onPinned); el.removeEventListener("lp-open", onOpen); watch.disconnect() }
+  }, [])
+  useEffect(() => { setMounted((all) => new Set([...all, active, active + 1])) }, [active])  // the next scene loads while this one plays
+  useEffect(() => {
+    const el = root.current
+    if (!el || pinned) return
+    const items = [...el.querySelectorAll(".lp-chap")]
+    const watch = new IntersectionObserver((entries) => entries.forEach((entry) => {
+      const i = items.indexOf(entry.target)
+      if (entry.isIntersecting && i >= 0) setSeen((all) => (all[i] ? all : all.map((v, j) => v || j === i)))
+    }), { threshold: 0.4 })
+    items.forEach((item) => watch.observe(item))
+    return () => watch.disconnect()
+  }, [pinned])
+  return (
+    <section className={`lp-chapters${chapters.length === 1 ? " is-single" : ""}`} ref={root} aria-label={eyebrow} data-priority={priority}>
+      <div className="lp-chap-glow" aria-hidden="true" />
+      <div className="lp-chap-side">
+        <header className="lp-chap-head">
+          <p className="lp-eyebrow">{eyebrow}</p>
+          <h2 data-split><Split lines={lines} /></h2>
+        </header>
+        <div className="lp-chap-copies" aria-hidden="true">
+          {chapters.map((c, i) => (
+            <div key={c.id} className={`lp-chap-copy${i === active ? " is-on" : ""}`}>
+              <span className="lp-chap-num">{String(i + 1).padStart(2, "0")}</span>
+              <h3><Split lines={[c.title]} /></h3>
+              <p>{c.text}</p>
+            </div>
+          ))}
+        </div>
+        {pinned && chapters.length > 1 && (
+          <nav className="lp-chap-index" aria-label="Chapters">
+          {chapters.map((c, i) => (
+            <button key={c.id} type="button" className={i === active ? "is-on" : ""} aria-current={i === active ? "step" : undefined} onClick={() => root.current?.dispatchEvent(new CustomEvent("lp-goto", { detail: i }))}>
+              <span aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>{c.title}
+            </button>
+          ))}
+        </nav>
+        )}
+      </div>
+      <ol className="lp-chap-list">
+        {chapters.map((c, i) => (
+          <li key={c.id} className={`lp-chap${pinned && i === active ? " is-active" : ""}`} aria-current={pinned && i === active ? "step" : undefined}>
+            <div className="lp-chap-copy">
+              <span className="lp-chap-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
+              <h3>{c.title}</h3>
+              <p>{c.text}</p>
+            </div>
+            <div className="lp-chap-stage">
+              <DemoFrame demo={c.demo} kind={c.kind} tabs={c.tabs} canvas={c.canvas} onDone={pinned ? () => advance(i) : undefined} play={pinned ? open && active === i : seen[i]} hold={pinned && !(near && mounted.has(i))} />
+            </div>
+          </li>
+        ))}
+      </ol>
+    </section>
+  )
+}
