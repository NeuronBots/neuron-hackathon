@@ -50,0 +36,22 @@ def close_stale_work() -> None:
+@app.on_event("startup")
+async def _start_pr_poll() -> None:
+    from services import pr_poll
+    if pr_poll.INTERVAL > 0 and background_agents() and not getattr(app.state, "pr_poll", None):
+        app.state.pr_poll = asyncio.create_task(pr_poll.scheduler())
+
+
+@app.on_event("startup")
+def close_stale_reviews() -> None:
+    """A PR review runs inside this process, so a restart ends it: its pill must stop spinning. Runs however the server is started."""
+    from core.database import SessionLocal
+    from core.models import Message
+
+    db = SessionLocal()
+    try:
+        for row in db.query(Message).filter(Message.content.like('[[SOURCES:{"kind": "pr"%"status": "running"%')).all():
+            row.content = row.content.replace('"status": "running"', '"status": "failed", "reason": "Interrupted by a server restart"')
+        db.commit()
+    finally:
+        db.close()
+
+
