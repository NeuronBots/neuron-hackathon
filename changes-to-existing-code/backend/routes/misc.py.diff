+class ShareDocIn(BaseModel):
+    users: list[str] = Field(default_factory=list)
+
+
+@router.post("/api/documents/{filename}/share")
+def share_document(filename: str, body: ShareDocIn, user: User = Depends(get_current_user), db: Session = Depends(get_db)):
+    import json
+    from core.models import DocumentRecord, Doc as DocModel
+    from sqlalchemy.orm.attributes import flag_modified
+    row = db.get(DocumentRecord, filename)
+    if not row or not user_may_read(user.id, filename, db=db):
+        raise HTTPException(status_code=404, detail="Document not found")
+    if row.user_id and row.user_id != user.id:
+        raise HTTPException(status_code=403, detail="Only the document creator can share it")
+    current = list(row.shared_with or [])
+    for u in body.users:
+        if u and u not in current:
+            current.append(u)
+    row.shared_with = current
+    flag_modified(row, "shared_with")
+
+    doc_model = db.get(DocModel, filename) or db.query(DocModel).filter((DocModel.id == filename) | (DocModel.title == row.title)).first()
+    if doc_model:
+        m_current = list(doc_model.shared_with or [])
+        if isinstance(m_current, str):
+            try: m_current = json.loads(m_current)
+            except Exception: m_current = []
+        for u in body.users:
+            if u and u not in m_current:
+                m_current.append(u)
+        doc_model.shared_with = m_current
+        flag_modified(doc_model, "shared_with")
+
+    db.commit()
+    return {"filename": row.filename, "shared_with": row.shared_with}
+
+
+@router.delete("/api/documents/{filename}", status_code=204)
+def delete_document_endpoint(filename: str, user = Depends(get_current_user_optional), db: Session = Depends(get_db)):
+    import json
+    from core.models import DocumentRecord, Doc as DocModel, User
+    from tools.documents import delete_document
+
+    rec = db.get(DocumentRecord, filename) or db.query(DocumentRecord).filter(DocumentRecord.title == filename).first()
+    doc_model = db.get(DocModel, filename) or db.query(DocModel).filter((DocModel.id == filename) | (DocModel.title == filename)).first()
+
+    if not rec and not doc_model:
+        from tools.documents import document_path
+        p = document_path(filename)
+        if p and p.is_file():
+            delete_document(filename)
+            return None
+        raise HTTPException(status_code=404, detail="Document not found")
+
+    if isinstance(user, User):
+        user_idents = {user.id.lower()}
+        if user.email:
+            user_idents.add(user.email.lower())
+
+        if rec and (rec.user_id or rec.created_by):
+            rec_owner = (rec.user_id or rec.created_by).lower()
+            shared = rec.shared_with or []
+            if isinstance(shared, str):
+                try: shared = json.loads(shared)
+                except Exception: shared = []
+            shared_lower = {str(s).lower() for s in shared}
+            if rec_owner not in user_idents and not any(i in shared_lower for i in user_idents):
+                raise HTTPException(status_code=403, detail="Permission denied")
+
+        if doc_model and (doc_model.user_id or doc_model.created_by):
+            doc_owner = (doc_model.user_id or doc_model.created_by).lower()
+            shared_m = doc_model.shared_with or []
+            if isinstance(shared_m, str):
+                try: shared_m = json.loads(shared_m)
+                except Exception: shared_m = []
+            shared_m_lower = {str(s).lower() for s in shared_m}
+            if doc_owner not in user_idents and not any(i in shared_m_lower for i in user_idents):
+                raise HTTPException(status_code=403, detail="Permission denied")
+
+    target_filename = rec.filename if rec else filename
+    if rec:
+        db.delete(rec)
+    if doc_model:
+        db.delete(doc_model)
+    db.commit()
+
+    try:
+        delete_document(target_filename)
+    except Exception:
+        pass
+    return None
+
