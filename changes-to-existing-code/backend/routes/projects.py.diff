+def _bot_id(db: Session, wanted: str, used: set[str]) -> str:
+    """The id for a new bot: the one the setup screen drew its avatar from when that is a fresh UUID, otherwise a new one. Chats draw a bot's avatar
+    from its id, so keeping it makes the avatar chosen here the one the bot keeps."""
+    try:
+        parsed = uuid.UUID((wanted or "").strip())
+    except ValueError:
+        return str(uuid.uuid4())
+    chosen = str(parsed)
+    if parsed.version != 4 or chosen in used or db.get(Agent, chosen) is not None:
+        return str(uuid.uuid4())
+    used.add(chosen)
+    return chosen
+
