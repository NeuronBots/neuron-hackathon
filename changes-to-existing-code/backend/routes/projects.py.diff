+_CORS = {"access-control-allow-origin": "*", "access-control-allow-methods": "GET, POST, PUT, PATCH, DELETE, HEAD, OPTIONS", "access-control-max-age": "600"}
+
+
+@router.api_route("/api/preview/{preview_id}/{key}/{path:path}", methods=["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"])
+async def preview_proxy(preview_id: str, key: str, path: str, request: Request):
+    """The running app, as the chat's frame sees it (no session: the frame is sandboxed away from it, and the key in the address stands in). The sandbox's own address is never given out.
+    A sandboxed frame has no origin of its own, so its requests to this server are cross-origin: they need CORS, which is safe here because nothing rides on cookies (the key is in the address)."""
+    found = preview.by_key(preview_id, key)
+    if found is None:
+        raise HTTPException(status_code=404, detail="That preview is not running.")
+    if request.method == "OPTIONS":  # the browser's question before a request that is not simple (a JSON POST): the app is not asked
+        return Response(status_code=204, headers={**_CORS, "access-control-allow-headers": request.headers.get("access-control-request-headers", "*")})
+    status, headers, content = await preview.forward(found, request.method, path, request.url.query, dict(request.headers), await request.body())
+    headers.update(_CORS)
+    headers["cache-control"] = "no-store"
+    headers["content-security-policy"] = "sandbox allow-scripts allow-forms allow-popups"  # no same-origin: the app cannot reach Neuron's cookies or API even if opened directly
+    headers["referrer-policy"] = "no-referrer"
+    return Response(content=content, status_code=status, headers=headers)
+
