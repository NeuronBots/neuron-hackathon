+SORRY = "Sorry, you don't have access to this."
+_SUMMARY_SYSTEM = (
+    "You write a short note for {name}, who cannot access the source of the text below ({sources}). "
+    "Give the gist in two or three plain sentences: what it is about and where it stands. "
+    "Do not quote it. Leave out ids, links, email addresses, names of private items, code and file contents."
+)
+
+
+async def _post_summary(project_id: str, asker_id: str, other_id: str, bot_id: str, reply_to: int | None, source: str, providers: str) -> None:
+    """Write the summary of a bot answer for the person who cannot open its source, and post it to the chat."""
+    from llm.client import complete
+    from llm.config import ASK_MODEL, CHAT_MODEL
+
+    key = (project_id, asker_id, other_id, bot_id)
+    typing_store.add_bot_typing(key)
+    token = set_usage_user(asker_id, project_id)
+    db = SessionLocal()
+    try:
+        other = db.get(User, other_id)
+        sources = ", ".join(p.capitalize() for p in providers.split(",") if p) or "a private source"
+        try:
+            text = await asyncio.to_thread(complete, ASK_MODEL or CHAT_MODEL, _SUMMARY_SYSTEM.format(name=other.name, sources=sources), source, 1500)  # the fast tier; the default one can spend the whole budget thinking and return no text
+        except Exception as exc:
+            print("summary failed:", type(exc).__name__, exc)
+            text = ""
+        db.add(DirectMessage(project_id=project_id, sender_id=asker_id, recipient_id=other_id, bot_id=bot_id, reply_to=reply_to,
+                             content=text or "I couldn't write a summary of that."))
+        db.commit()
+    finally:
+        reset_usage_user(token)
+        db.close()
+        typing_store.remove_bot_typing(key)
+
+
+@router.post("/api/direct/{other_id}/{message_id}/share")
+async def decide_share(other_id: str, message_id: int, body: ShareIn, user: User = Depends(get_current_user), project: Project = Depends(get_project), db: Session = Depends(get_db)):
+    """The asker's answer to "share this with them?". Yes sends a summary; no tells the other person they have no access."""
+    other = _other(other_id, user, project, db)
+    row = db.query(DirectMessage).filter(DirectMessage.id == message_id, _between(project.id, user.id, other.id)).with_for_update().first()
+    if row is None or row.sender_id != user.id or not row.bot_id:
+        raise HTTPException(status_code=404, detail="No such message")
+    if row.share != "pending":
+        raise HTTPException(status_code=409, detail="Already decided")
+    row.share = "shared" if body.share else "declined"
+    if not body.share:
+        db.add(DirectMessage(project_id=project.id, sender_id=user.id, recipient_id=other.id, bot_id=row.bot_id, reply_to=row.reply_to, content=SORRY))
+    db.commit()
+    if body.share:
+        runs.spawn(_post_summary(project.id, user.id, other.id, row.bot_id, row.reply_to, row.content, row.withheld))
+    return _read(row)
+
+
