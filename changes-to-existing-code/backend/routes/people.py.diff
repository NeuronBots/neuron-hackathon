+async def _post_summary(row_id: int) -> None:
+    """Write the summary of a bot answer for the person who cannot open its source, as a draft only its asker sees. Nothing reaches the other
+    person until the asker confirms it (decide_draft). If writing it fails, the answer goes back to "pending" so its asker can try again."""
+    from llm.client import complete
+    from llm.config import ASK_MODEL, CHAT_MODEL
+
+    db = SessionLocal()
+    row = db.get(DirectMessage, row_id)
+    key = (row.project_id, row.sender_id, row.recipient_id, row.bot_id)
+    typing_store.add_bot_typing(key)
+    token = set_usage_user(row.sender_id, row.project_id)
+    try:
+        sources = ", ".join(p.capitalize() for p in row.withheld.split(",") if p) or "a private source"
+        system = _SUMMARY_SYSTEM.format(name=db.get(User, row.recipient_id).name, sources=sources)
+        text = await asyncio.to_thread(complete, ASK_MODEL or CHAT_MODEL, system, f"<source>\n{row.content}\n</source>", 1500)  # the fast tier; the default one can spend the whole budget thinking and return no text
+        text = audience.scrub(text)  # a floor under what the model was asked to leave out; the asker reads the rest before it is sent
+        if not text:
+            raise RuntimeError("empty summary")
+        db.add(DirectMessage(project_id=row.project_id, sender_id=row.sender_id, recipient_id=row.recipient_id, bot_id=row.bot_id, reply_to=row.reply_to,
+                             content=text, share="draft", action=json.dumps({"of": row.id})))
+        row.share = "drafted"
+        db.commit()
+    except Exception as exc:
+        print("summary failed:", type(exc).__name__, exc)
+        db.rollback()
+        db.query(DirectMessage).filter(DirectMessage.id == row_id, DirectMessage.share == "sharing").update({"share": "pending"}, synchronize_session=False)
+        db.commit()
+    finally:
+        reset_usage_user(token)
+        db.close()
+        typing_store.remove_bot_typing(key)
+
