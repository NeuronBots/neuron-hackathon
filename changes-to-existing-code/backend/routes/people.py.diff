+        db.add(DirectMessage(project_id=row.project_id, sender_id=row.sender_id, recipient_id=row.recipient_id, bot_id=row.bot_id, reply_to=row.reply_to,
+                             content=done_note(call["tool"], call["args"], result)))
+        row.share = "done"
+        db.commit()
+    except Exception as exc:
+        print("action failed:", type(exc).__name__, exc)
+        db.rollback()
+        db.query(DirectMessage).filter(DirectMessage.id == row_id, DirectMessage.share == "running").update({"share": "proceed"}, synchronize_session=False)
+        db.add(DirectMessage(project_id=row.project_id, sender_id=row.sender_id, recipient_id=row.recipient_id, bot_id=row.bot_id, reply_to=row.reply_to, share="private",
+                             content=f"That did not go through: {audience.scrub(str(exc).removeprefix('Error: '), 300)} You can press Proceed to try again."))
+        db.commit()
