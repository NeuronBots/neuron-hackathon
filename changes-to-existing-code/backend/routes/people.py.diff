+def _share_forwarded_documents(content: str, sender_id: str, recipient: User, db: Session) -> None:
+    """When a message with document references is forwarded/sent to a person, grant that person access
+    ONLY if the sender owns the document and may read it."""
+    if not content:
+        return
+    import re
+    from core.models import DocumentRecord, Doc as DocModel
+    from tools.documents import _as_list, user_may_read, can_read
+    from sqlalchemy.orm.attributes import flag_modified
+
+    # Match exact full path references only: /api/documents/{filename} or /api/docs/{id}
+    doc_files = re.findall(r"/api/documents/([A-Za-z0-9][A-Za-z0-9._-]{0,120})", content)
+    doc_ids = re.findall(r"/api/docs/([A-Za-z0-9._-]+)", content)
+
+    all_targets = set(doc_files + doc_ids)
+    if not all_targets:
+        return
+
+    recipient_idents = [recipient.id]
+    if recipient.email:
+        recipient_idents.append(recipient.email)
+
+    for raw_target in all_targets:
+        target = raw_target.rstrip(".,;:)")
+        # Match exact DocumentRecord.filename or Doc.id only (no title or bare matching)
+        doc_rec = db.get(DocumentRecord, target)
+        doc_model = db.get(DocModel, target)
+        if not doc_rec and doc_model:
+            doc_rec = db.get(DocumentRecord, doc_model.id)
+        if not doc_model and doc_rec:
+            doc_model = db.get(DocModel, doc_rec.filename)
+
+        # Sender must be the owner and have read access
+        if doc_rec:
+            if not user_may_read(sender_id, doc_rec.filename, db=db):
+                continue
+            is_owner = (doc_rec.user_id and doc_rec.user_id == sender_id) or (doc_rec.created_by and doc_rec.created_by == sender_id)
+            if not is_owner:
+                continue
+
+            current_shared = _as_list(doc_rec.shared_with)
+            changed = False
+            for ident in recipient_idents:
+                if ident not in current_shared and ident.lower() not in [str(s).lower() for s in current_shared]:
+                    current_shared.append(ident)
+                    changed = True
+            if changed:
+                doc_rec.shared_with = current_shared
+                flag_modified(doc_rec, "shared_with")
+
+        if doc_model:
+            is_m_owner = (doc_model.user_id and doc_model.user_id == sender_id) or (doc_model.created_by and doc_model.created_by == sender_id)
+            if not is_m_owner and not doc_rec:
+                continue
+            sender_idents = {sender_id.lower()}
+            sender_user = db.get(User, sender_id)
+            if sender_user and sender_user.email:
+                sender_idents.add(sender_user.email.lower())
+            if not can_read(doc_model, sender_id, sender_idents, db=db):
+                continue
+
+            current_shared_model = _as_list(doc_model.shared_with)
+            changed_m = False
+            for ident in recipient_idents:
+                if ident not in current_shared_model and ident.lower() not in [str(s).lower() for s in current_shared_model]:
+                    current_shared_model.append(ident)
+                    changed_m = True
+            if changed_m:
+                doc_model.shared_with = current_shared_model
+                flag_modified(doc_model, "shared_with")
+
+    db.flush()
