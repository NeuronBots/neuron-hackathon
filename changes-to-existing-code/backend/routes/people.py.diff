+    call = json.loads(row.action)
+    key = (row.project_id, row.sender_id, row.recipient_id, row.bot_id)
+    typing_store.add_bot_typing(key)
+    token = set_usage_user(row.sender_id, row.project_id)
+    ctx = set_audience([row.recipient_id], f"{row.project_id}:{':'.join(sorted((row.sender_id, row.recipient_id)))}", approved=True)
+    try:
+        result = await run_tool(call["tool"], call["args"], call["jira_key"], call["repo"], call["agent_id"])
