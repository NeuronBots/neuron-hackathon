+@app.middleware("http")
+async def sandboxed_preflight(request, call_next):
+    """A hosted site or a live preview runs sandboxed, so its requests carry Origin: null, which the CORS list above refuses (the page then fails with "Load failed").
+    Their preflights are answered here, outside it; the routes still decide what each request may do."""
+    if request.method == "OPTIONS" and request.url.path.startswith(("/sites/", "/api/preview/")):
