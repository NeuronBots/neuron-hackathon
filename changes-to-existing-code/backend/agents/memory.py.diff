+def add_core_memory(agent: Agent, fact: str, source: str = "a person's answer") -> None:
+    """Append one fact to the bot's core memory at once (something a person did: it is already approved)."""
+    from agents.versions import set_prod
+    if (text := with_fact(agent.core_memory, fact)) is not None:
+        set_prod(agent, "core_memory", text, source)
+
+
+def propose_core_memory(agent: Agent, fact: str) -> bool:
+    """The bot's own wish to remember something: held as a draft until a person promotes it. False when it adds nothing."""
+    from agents.versions import draft_of, stage
+    draft = draft_of(agent, "core_memory")
+    if (text := with_fact(draft.content if draft else agent.core_memory, fact)) is None:
+        return False
+    stage(agent, "core_memory", text, "the bot's own [[REMEMBER]]")
+    return True
