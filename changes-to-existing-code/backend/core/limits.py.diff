--- a/backend/core/limits.py
+++ b/backend/core/limits.py
@@ -12,0 +13,13 @@ def week_start(now: datetime) -> datetime:
+VOICE_FACTOR = 1.5  # legacy: calls before duration billing were counted by transcript characters
+VOICE_TOKENS_PER_SEC = 30  # a live call costs this many tokens per second of ElevenLabs call time (1800 a minute); tune here and in src/types.ts
+
+
+def voice_to_tokens(characters: int) -> int:
+    """Standard half-up rounding (matching frontend Math.round) for voice character weighting."""
+    return int(characters * VOICE_FACTOR + 0.5) if characters > 0 else 0
+
+
+def voice_seconds_to_tokens(seconds: float) -> int:
+    return int(seconds * VOICE_TOKENS_PER_SEC + 0.5) if seconds > 0 else 0
+
+
@@ -14 +27,3 @@ def tokens_used(db, since: datetime, user_ids: list[str] | None = None, narrow=N
-    """Input + output + cache read + cache write tokens per user since a moment. Users with no events are absent."""
+    """Input + output + cache read + cache write tokens + legacy voice characters * 1.5 + call seconds * VOICE_TOKENS_PER_SEC per user since a moment. Users with no events are absent."""
+    from sqlalchemy import case
+
@@ -17,2 +32,12 @@ def tokens_used(db, since: datetime, user_ids: list[str] | None = None, narrow=N
-    cols = (UsageEvent.input_tokens, UsageEvent.output_tokens, UsageEvent.cache_read_tokens, UsageEvent.cache_write_tokens)
-    query = db.query(UsageEvent.user_id, *(func.coalesce(func.sum(c), 0) for c in cols)).filter(UsageEvent.created_at >= since)
+    cols = (
+        UsageEvent.input_tokens,
+        UsageEvent.output_tokens,
+        UsageEvent.cache_read_tokens,
+        UsageEvent.cache_write_tokens,
+    )
+    query = db.query(
+        UsageEvent.user_id,
+        *(func.coalesce(func.sum(c), 0) for c in cols),
+        func.coalesce(func.sum(UsageEvent.characters), 0),
+        func.coalesce(func.sum(case((UsageEvent.kind == "call", UsageEvent.audio_seconds), else_=0.0)), 0.0),
+    ).filter(UsageEvent.created_at >= since)
@@ -23 +48,31 @@ def tokens_used(db, since: datetime, user_ids: list[str] | None = None, narrow=N
-    return {uid: sum(int(n) for n in totals) for uid, *totals in query.group_by(UsageEvent.user_id).all()}
+    return {
+        uid: int(sum(int(n) for n in totals) + voice_to_tokens(int(chars)) + voice_seconds_to_tokens(float(secs)))
+        for uid, *totals, chars, secs in query.group_by(UsageEvent.user_id).all()
+    }
+
+
+def voice_units_used(db, since: datetime, user_ids: list[str] | None = None, narrow=None) -> dict[str, dict]:
+    """Voice usage (characters, audio_seconds, calls) per user since a moment. Users with no voice events are absent."""
+    from core.models import UsageEvent
+
+    query = db.query(
+        UsageEvent.user_id,
+        func.coalesce(func.sum(UsageEvent.characters), 0),
+        func.coalesce(func.sum(UsageEvent.audio_seconds), 0.0),
+        func.count(UsageEvent.id),
+    ).filter(
+        UsageEvent.created_at >= since,
+        UsageEvent.kind.in_(("tts", "stt", "voice")),
+    )
+    if user_ids is not None:
+        query = query.filter(UsageEvent.user_id.in_(user_ids))
+    if narrow:
+        query = narrow(query)
+    return {
+        uid: {
+            "characters": int(chars),
+            "audio_seconds": float(secs),
+            "calls": int(calls),
+        }
+        for uid, chars, secs, calls in query.group_by(UsageEvent.user_id).all()
+    }
