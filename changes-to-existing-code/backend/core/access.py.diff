@@ -105,0 +124,18 @@ def get_project(
+def get_project_optional(
+    request: Request,
+    user = Depends(get_current_user_optional),
+    db: Session = Depends(get_db),
+) -> Project | None:
+    from core.models import User
+    if not isinstance(user, User):
+        return None
+    project_id = (request.headers.get("x-project-id") or "").strip()
+    memberships = projects_for(user, db)
+    if not project_id and len(memberships) == 1:
+        project_id = memberships[0]["id"]
+    match = next((item for item in memberships if item["id"] == project_id), None)
+    if match is None:
+        return None
+    return db.get(Project, project_id)
