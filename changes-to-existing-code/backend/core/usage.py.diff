+def record_tts_usage(
+    user_id: str | None = None,
+    *,
+    characters: int,
+    voice_id: str = "",
+    model: str = "eleven_multilingual_v2",
+    audio_seconds: float = 0.0,
+    agent_id: str | None = None,
+    request_id: str = "",
+    project_id: str | None = None,
+    apply_minimum: bool = True,
+    min_characters: int = 250,
+    db=None,
+):
+    """Record completed and settled ElevenLabs TTS usage to the central usage ledger with deduplication."""
+    uid = user_id if user_id is not None else _user_id.get()
+    ctx_agent, ctx_kind = _ctx.get()
+    aid = (ctx_agent if agent_id is None else agent_id) or ""
+    proj_id = project_id if project_id is not None else _project_id.get()
+
+    billed_characters = max(int(characters or 0), min_characters) if (apply_minimum and min_characters > 0) else int(characters or 0)
+    audio_secs = float(audio_seconds or 0.0)
+
+    req_id = (request_id or "").strip()[:64]
+    if not req_id:
+        import hashlib
+        req_id = f"gen:{hashlib.sha256(f'tts:{uid}:{aid}:{model}:{voice_id}:{billed_characters}:{audio_secs}'.encode()).hexdigest()[:28]}"
+
+    from core import jsonl
+    jsonl.emit(
+        "voice.tts.usage",
+        user_id=uid or None,
+        agent_id=aid or None,
+        model=model,
+        voice_id=voice_id,
+        characters=billed_characters,
+        raw_characters=characters,
+        audio_seconds=audio_secs,
+        request_id=req_id,
+    )
+
+    if not uid:
+        return None
+
+    from core.database import SessionLocal
+    from core.models import UsageEvent
+    from core.limits import invited_project
+
+    own_session = db is None
+    session = db or SessionLocal()
+    try:
+        existing = session.query(UsageEvent).filter(
+            UsageEvent.request_id == req_id,
+            UsageEvent.kind == "tts",
+        ).first()
+        if existing:
+            return existing
+
+        event = UsageEvent(
+            user_id=uid,
+            model=(model or voice_id or "eleven_multilingual_v2")[:120],
+            voice_id=(voice_id or "")[:64],
+            characters=billed_characters,
+            audio_seconds=audio_secs,
+            agent_id=aid[:36],
+            kind="tts",
+            request_id=req_id,
+            project_id=invited_project(uid, proj_id),
+            created_at=datetime.utcnow(),
+        )
+        session.add(event)
+        session.commit()
+        session.refresh(event)
+        return event
+    except Exception:
+        session.rollback()
+        existing = session.query(UsageEvent).filter(
+            UsageEvent.request_id == req_id,
+            UsageEvent.kind == "tts",
+        ).first()
+        if existing:
+            return existing
+        return None
+    finally:
+        if own_session:
+            session.close()
+
+
+def record_call_usage(user_id: str, *, seconds: float, agent_id: str, request_id: str, project_id: str | None = None, db=None):
+    """One live voice call, billed by its length in seconds. kind "call" is the only voice kind whose seconds count toward the caps.
+    request_id makes a retried save a no-op."""
+    from core import jsonl
+    from core.database import SessionLocal
+    from core.limits import invited_project
+    from core.models import UsageEvent
+
+    jsonl.emit("voice.call.usage", user_id=user_id, agent_id=agent_id, audio_seconds=seconds, request_id=request_id)
+    own_session = db is None
+    session = db or SessionLocal()
+    try:
+        existing = session.query(UsageEvent).filter(UsageEvent.request_id == request_id, UsageEvent.kind == "call").first()
+        if existing:
+            return existing
+        event = UsageEvent(user_id=user_id, model="elevenlabs-agent", audio_seconds=float(seconds), agent_id=agent_id[:36], kind="call",
+                           request_id=request_id[:64], project_id=invited_project(user_id, project_id), created_at=datetime.utcnow())
+        session.add(event)
+        session.commit()
+        return event
+    except Exception:
+        session.rollback()  # a concurrent save of the same call won the unique (request_id, kind)
+        return session.query(UsageEvent).filter(UsageEvent.request_id == request_id, UsageEvent.kind == "call").first()
+    finally:
+        if own_session:
+            session.close()
+
+
+def record_stt_usage(
+    user_id: str | None = None,
+    *,
+    audio_seconds: float = 0.0,
+    minutes: float | None = None,
+    characters: int = 0,
+    model: str = "scribe_v1",
+    agent_id: str | None = None,
+    request_id: str = "",
+    project_id: str | None = None,
+    db=None,
+):
+    """Record completed and settled ElevenLabs STT usage to the central usage ledger with deduplication on retry."""
+    uid = user_id if user_id is not None else _user_id.get()
+    ctx_agent, ctx_kind = _ctx.get()
+    aid = (ctx_agent if agent_id is None else agent_id) or ""
+    proj_id = project_id if project_id is not None else _project_id.get()
+
+    if minutes is not None and (audio_seconds == 0.0 or audio_seconds is None):
+        audio_secs = float(minutes) * 60.0
+    else:
+        audio_secs = float(audio_seconds or 0.0)
+
+    calc_minutes = audio_secs / 60.0 if audio_secs > 0 else (float(minutes) if minutes is not None else 0.0)
+    chars = int(characters or 0)
+
+    req_id = (request_id or "").strip()[:64]
+    if not req_id:
+        import hashlib
+        req_id = f"gen:{hashlib.sha256(f'stt:{uid}:{aid}:{model}:{chars}:{audio_secs}'.encode()).hexdigest()[:28]}"
+
+    from core import jsonl
+    jsonl.emit(
+        "voice.stt.usage",
+        user_id=uid or None,
+        agent_id=aid or None,
+        model=model,
+        characters=chars,
+        audio_seconds=audio_secs,
+        minutes=calc_minutes,
+        request_id=req_id,
+    )
+
+    if not uid:
+        return None
+
+    from core.database import SessionLocal
+    from core.models import UsageEvent
+    from core.limits import invited_project
+
+    own_session = db is None
+    session = db or SessionLocal()
+    try:
+        existing = session.query(UsageEvent).filter(
+            UsageEvent.request_id == req_id,
+            UsageEvent.kind == "stt",
+        ).first()
+        if existing:
+            return existing
+
+        event = UsageEvent(
+            user_id=uid,
+            model=(model or "scribe_v1")[:120],
+            characters=chars,
+            audio_seconds=audio_secs,
+            agent_id=aid[:36],
+            kind="stt",
+            request_id=req_id,
+            project_id=invited_project(uid, proj_id),
+            created_at=datetime.utcnow(),
+        )
+        session.add(event)
+        session.commit()
+        session.refresh(event)
+        return event
+    except Exception:
+        session.rollback()
+        existing = session.query(UsageEvent).filter(
+            UsageEvent.request_id == req_id,
+            UsageEvent.kind == "stt",
+        ).first()
+        if existing:
+            return existing
+        return None
+    finally:
+        if own_session:
+            session.close()
+
