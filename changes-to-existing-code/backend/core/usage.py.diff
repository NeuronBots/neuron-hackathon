+class StreamedSynthesisAccumulator:
+    """Tracks streaming synthesis chunks/events with partials and retries.
+    Intermediate partial events accumulate without writing to the ledger;
+    only the final settled usage is counted once."""
+
+    def __init__(
+        self,
+        request_id: str,
+        user_id: str | None = None,
+        agent_id: str | None = None,
+        voice_id: str = "",
+        model: str = "eleven_multilingual_v2",
+        project_id: str | None = None,
+    ):
+        self.request_id = request_id
+        self.user_id = user_id
+        self.agent_id = agent_id
+        self.voice_id = voice_id
+        self.model = model
+        self.project_id = project_id
+        self.total_characters = 0
+        self.total_audio_seconds = 0.0
+        self.settled = False
+        self._settled_event = None
+
+    def emit_partial(self, characters: int = 0, audio_seconds: float = 0.0) -> None:
+        """Receive a partial streamed chunk. Does not write to ledger yet."""
+        if self.settled:
+            return
+        self.total_characters += int(characters or 0)
+        self.total_audio_seconds += float(audio_seconds or 0.0)
+
+    def settle(
+        self,
+        characters: int | None = None,
+        audio_seconds: float | None = None,
+        min_characters: int = 250,
+        apply_minimum: bool = True,
+        db=None,
+    ):
+        """Settle the streamed synthesis. Only final settled usage is counted once."""
+        if self.settled and self._settled_event is not None:
+            return self._settled_event
+
+        chars = self.total_characters if characters is None else int(characters)
+        secs = self.total_audio_seconds if audio_seconds is None else float(audio_seconds)
+        self.settled = True
+        self._settled_event = record_tts_usage(
+            user_id=self.user_id,
+            characters=chars,
+            voice_id=self.voice_id,
+            model=self.model,
+            audio_seconds=secs,
+            agent_id=self.agent_id,
+            request_id=self.request_id,
+            project_id=self.project_id,
+            apply_minimum=apply_minimum,
+            min_characters=min_characters,
+            db=db,
+        )
+        return self._settled_event
+
+
+def settle_streamed_synthesis(
+    request_id: str,
+    characters: int,
+    user_id: str | None = None,
+    *,
+    voice_id: str = "",
+    model: str = "eleven_multilingual_v2",
+    audio_seconds: float = 0.0,
+    agent_id: str | None = None,
+    project_id: str | None = None,
+    min_characters: int = 250,
+    apply_minimum: bool = True,
+    db=None,
+):
+    """Convenience helper to settle streamed synthesis for a request_id in one call, ensuring dedupe."""
+    return record_tts_usage(
+        user_id=user_id,
+        characters=characters,
+        voice_id=voice_id,
+        model=model,
+        audio_seconds=audio_seconds,
+        agent_id=agent_id,
+        request_id=request_id,
+        project_id=project_id,
+        apply_minimum=apply_minimum,
+        min_characters=min_characters,
+        db=db,
+    )
