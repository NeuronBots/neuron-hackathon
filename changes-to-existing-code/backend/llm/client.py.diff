+import asyncio
@@ -10 +11,2 @@ from llm.text_tools import strip_text_tool_calls
-from core.usage import note_payload
+from core.limits import over_limit
+from core.usage import current_user, note_payload
@@ -13,0 +16,30 @@ NOW = "\n\nThe current time is "
+BUSY = (402, 429, 502, 503, 529)  # the provider is busy for a moment, then recovers (it answered 402 under ten parallel calls). Only these statuses are retried, not network errors
+TRIES = 4
+
+
+def backoff(n: int) -> float:
+    """Seconds to wait after the nth busy answer (n from 0)."""
+    return 1.5 * (n + 1)
+
+
+def _headers() -> dict:
+    return {"x-api-key": ANTHROPIC_API_KEY, "anthropic-version": "2023-06-01", "content-type": "application/json"}
+
+
+def post_retry(client: httpx.Client, body: dict) -> httpx.Response:
+    """POST one /messages request, waiting and asking again (1.5 s, 3 s, 4.5 s) while the provider says it is busy."""
+    for n in range(TRIES):
+        resp = client.post(f"{ANTHROPIC_BASE}/messages", headers=_headers(), json=body)
+        if resp.status_code not in BUSY or n == TRIES - 1:
+            return resp
+        time.sleep(backoff(n))
+
+
+async def apost_retry(client: httpx.AsyncClient, body: dict, tries: int = TRIES) -> httpx.Response:
+    """post_retry for an async client; tries=1 makes a single attempt."""
+    for n in range(tries):
+        resp = await client.post(f"{ANTHROPIC_BASE}/messages", headers=_headers(), json=body)
+        if resp.status_code not in BUSY or n == tries - 1:
+            return resp
+        await asyncio.sleep(backoff(n))
+
