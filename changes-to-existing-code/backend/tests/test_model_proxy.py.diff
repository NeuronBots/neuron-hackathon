+def test_openrouter():
+    orr, real, _ = prep("openrouter")
+    assert orr["model"] == real and "/" in real
+    assert "output_config" not in orr, "no effort is sent unless OPENROUTER_EFFORT_* is set"
+    assert mp._PROVIDERS["openrouter"]["url"].endswith("/api/v1/messages")
+
+
+def test_meta():
+    meta = mp._PROVIDERS["meta"]
+    assert meta["url"].endswith("/messages") and meta["key_env"] == "META_API_KEY"
+    got = [prep("meta", t) for t in mp.TIERS]  # callers may ask for a tier by name
+    assert [r for _, r, _ in got] == ["muse-spark-1.3"] * 3 + ["muse-wonder-1.0"]
+    assert [b.get("output_config", {}).get("effort") for b, _, _ in got] == ["low", "medium", "high", "high"]
+    assert [prep("meta", f"claude-{m}")[1] for m in ("haiku-5-5", "sonnet-5-5", "opus-5-5", "fable-5-1")] == [r for _, r, _ in got], "Claude ids land on the same tiers"
+    assert prep("meta", "something-else")[1] == "muse-spark-1.3", "unknown ids fall back to the workhorse tier"
+
+
+def test_every_provider_fills_every_tier():
+    for name, prov in mp._PROVIDERS.items():
+        assert set(prov["models"]) == set(prov["effort"]) == set(mp.TIERS), name
+        assert all(prov["models"].values()), name
+
+
+def test_legacy_env_names_still_work(monkeypatch):
+    monkeypatch.setenv("OPENROUTER_MODEL_OPUS", "old-opus")
+    monkeypatch.setenv("OPENROUTER_MODEL_JUDGEMENT", "new-judgement")
+    assert mp._tiers("OPENROUTER", dict.fromkeys(mp.TIERS, "d"))["judgement"] == "new-judgement", "the tier name wins"
+    monkeypatch.delenv("OPENROUTER_MODEL_JUDGEMENT")
+    assert mp._tiers("OPENROUTER", dict.fromkeys(mp.TIERS, "d"))["judgement"] == "old-opus"
+
+
+def test_identity_for_every_provider():
+    for name, prov in mp._PROVIDERS.items():
+        text = prep(name)[0]["system"][0]["text"]
+        assert text == (
+            "You are Neuron, an AI model. If asked who or what model you are, say you are Neuron. "
+            f"Never say you are {prov['never']}."
+        ), name
+        assert "Claude" not in text, name
+
+
+def test_prepare_does_not_mutate_the_caller_body():
+    body = copy.deepcopy(BODY)
+    mp.prepare(body, mp._PROVIDERS["meta"])
+    assert body == BODY
+
+
+if __name__ == "__main__":
