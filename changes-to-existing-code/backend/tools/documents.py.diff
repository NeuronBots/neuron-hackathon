+def user_may_read(user_id: str, filename: str, db=None) -> bool:
+    from core.database import SessionLocal
+    from core.models import DocumentRecord, User
+
+    session = db or SessionLocal()
+    try:
+        row = session.get(DocumentRecord, filename)
+        if not row:
+            return False
+        user_idents = {user_id.lower()}
+        user_obj = session.get(User, user_id)
+        if user_obj and user_obj.email:
+            user_idents.add(user_obj.email.lower())
+        return can_read(row, user_id, user_idents, db=session)
+    finally:
+        if db is None:
+            session.close()
