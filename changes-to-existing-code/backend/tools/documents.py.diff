@@ -79,0 +80,76 @@ def replace_document(filename: str, data: bytes) -> None:
+def _as_list(v) -> list:
+    """Safely coerce a JSON column value, comma-delimited string, or list to a list."""
+    if v is None:
+        return []
+    if isinstance(v, str):
+        s = v.strip()
+        if not s:
+            return []
+        try:
+            parsed = json.loads(s)
+            if isinstance(parsed, list):
+                return parsed
+        except Exception:
+            return [t.strip() for t in s.split(",") if t.strip()]
+    if isinstance(v, (list, tuple, set)):
+        return list(v)
+    return [v]
+
+
+def can_read(
+    doc,
+    user_id: str | None,
+    identifiers: set[str] | None = None,
+    project_ids: set[str] | None = None,
+    db=None,
+) -> bool:
+    """Shared predicate for document visibility across DocModel and DocumentRecord.
+    Unowned documents mean project members only, never guests.
+    """
+    if not user_id:
+        return False
+
+    idents = set(identifiers or ())
+    idents.add(user_id)
+    idents_lower = {i.lower() for i in idents}
+
+    owner = getattr(doc, "created_by", None) or getattr(doc, "user_id", None)
+    if owner:
+        if owner.lower() in idents_lower or owner in idents:
+            return True
+        shared = _as_list(getattr(doc, "shared_with", None))
+        shared_lower = {str(s).lower() for s in shared}
+        return any(i in shared_lower for i in idents_lower)
+
+    # Unowned document: project members only
+    proj_id = getattr(doc, "project_id", None)
+    if not proj_id and db is not None:
+        from core.models import DocumentRecord
+        doc_id = getattr(doc, "filename", None) or getattr(doc, "id", None)
+        if doc_id:
+            rec = db.get(DocumentRecord, doc_id)
+            if rec:
+                proj_id = rec.project_id
+
+    if proj_id:
+        if project_ids is not None:
+            return proj_id in project_ids
+        if db is not None:
+            from core.models import ProjectMember
+            return db.get(ProjectMember, (proj_id, user_id)) is not None
+        from core.database import SessionLocal
+        from core.models import ProjectMember
+        with SessionLocal() as s:
+            return s.get(ProjectMember, (proj_id, user_id)) is not None
+
+    if project_ids is not None:
+        return len(project_ids) > 0
+    if db is not None:
+        from core.models import ProjectMember
+        return db.query(ProjectMember).filter(ProjectMember.user_id == user_id).first() is not None
+    from core.database import SessionLocal
+    from core.models import ProjectMember
+    with SessionLocal() as s:
+        return s.query(ProjectMember).filter(ProjectMember.user_id == user_id).first() is not None
+
+
