+def _body(parts: list[tuple[str, str]]) -> str:
+    """What the person is shown: a line saying what is asked, one bullet per action, then every action's full details."""
+    n = len(parts)
+    bullets = "\n".join(f"• {headline}" for headline, _ in parts)
+    details = "\n\n———\n\n".join(detail for _, detail in parts)
+    return f"Needs your permission to do {'this' if n == 1 else f'these {n} things'}.\n{bullets}\n\nApprove to run {'it' if n == 1 else 'them'} exactly as written.\n\n{details}"
+
+
+def _card(task: Task, agent_id: str, name: str, parts: list[tuple[str, str]], interactive: bool) -> str:
+    card = {"kind": "approval", "task_id": task.id, "agent_id": agent_id, "name": name, "title": task.title, "detail": _body(parts)[:6000], "interactive": interactive, "count": len(parts)}
+    return "[[SOURCES:" + json.dumps(card).replace("]]", "] ]").replace("[[", "[ [") + "]]"
+
+
+def _park(agent_id: str, headline: str, detail: str, call: dict, db: Session, interactive: bool = False, turn: dict | None = None, title: str = "") -> Task:
+    """Hold one outward call for a person's say-so: a task on the board, and a card in the bot's chat. Calls parked in the same turn
+    (`turn` is that turn's own dict) join the first one's task and card, so a person answers once. Approving runs them all, in order."""
+    agent = db.get(Agent, agent_id)
+    group = (turn or {}).get("group")
+    task = db.get(Task, group["task"]) if group else None
+    if group and task is not None and task.status == "decision":
+        group["parts"].append((headline, detail))
+        group["calls"].append(call)
+        task.title = f"Approve {len(group['parts'])} actions"
+        events = db.query(TaskEvent).filter(TaskEvent.task_id == task.id).order_by(TaskEvent.id).all()
+        events[0].text = _body(group["parts"])
+        next(e for e in reversed(events) if e.text.startswith(MAIL_DRAFT)).text = MAIL_DRAFT + json.dumps({"calls": group["calls"]})
+        if (row := db.get(Message, group["message"])) is not None:
+            row.content = _card(task, agent_id, agent.name if agent else "", group["parts"], interactive)
+        db.commit()
+        return task
+    task = Task(agent_id=agent_id, title=(title or f"Approve: {headline}")[:200], status="decision")
+    db.add(task)
+    db.flush()
+    parts = [(headline, detail)]
+    append_full(task, agent.name if agent else "Bot", _body(parts))
+    append_full(task, "System", MAIL_DRAFT + json.dumps(call))
+    message = None
+    if agent:  # the same decision, as a card in the bot's own chat: answering there answers the task
+        append_history(agent, "assistant", _card(task, agent_id, agent.name, parts, interactive))
+        message = db.query(Message).filter(Message.agent_id == agent.id, Message.role == "assistant").order_by(Message.id.desc()).first()
+    db.commit()
+    if not interactive:  # a person in the chat is looking at the card already
+        notify_pending(agent_id, task.title, db)
+    if turn is not None and message is not None:
+        turn["group"] = {"task": task.id, "message": message.id, "parts": parts, "calls": [call]}
+    return task
+
