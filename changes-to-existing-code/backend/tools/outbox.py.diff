+_LOCAL_JIRA_WRITES = ("manageJiraSprint", "planSprint", "attachDocumentToJiraIssue")  # built on raw Atlassian calls, run in tools/dispatch.py
+_LOCAL_OUTWARD = _LOCAL_JIRA_WRITES + ("build_wiki", "publish_build", "build_project", "push_pr_fix", "publish_site", "update_site", "add_routine", "update_routine")  # publish_site and update_site change the public website; build_wiki publishes to the repo's GitHub wiki; publish_build pushes a branch and opens a pull request; build_project starts a long, costly build
