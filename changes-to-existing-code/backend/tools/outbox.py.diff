+def run_queue_write(agent_id: str, name: str, args: dict, jira_key: str, repo: str, db: Session, interactive: bool = False, turn: dict | None = None) -> tuple[str, Optional[dict]]:
+    """Any other outward write by a bot: parked with the whole call, and run only on 'Approved'. The Jira project and repo it was
+    scoped to are kept, so the approved call is limited exactly as the bot's would have been."""
+    if full := _room(agent_id, db, interactive, turn):
+        return full, None
+    head, _, detail = describe(name, args).partition("\n")
+    task = _park(agent_id, head.strip(), detail.strip(), {"tool": name, "args": args, "jira_key": jira_key, "repo": repo}, db, interactive, turn)
+    return _told("NOT done", interactive,
+        "NOT done yet: bots working on their own need permission for this. It is waiting for a human to approve, with exactly what you asked for. "
+        "Carry on with other work; do not call it again, and do not say it is done."
+    ), {"type": "task_decision", "title": task.title}
+
+
+def queue_outward(agent_id: str, name: str, args: dict, jira_key: str, repo: str, db: Session, interactive: bool = False, turn: dict | None = None) -> Optional[tuple[str, Optional[dict]]]:
+    """The (text for the bot, board event) of the approval queued for an outward write, or None when the call is not outward and may
+    simply run. The one gate: for a bot with nobody in its chat, and (interactive) for a person's own chat until they allow it.
+    `turn` is the running turn's own dict: what is parked in one turn is asked of the person once."""
+    if not is_outward(name):
+        return None
+    if len(json.dumps(args, default=str)) > MAX_CALL_CHARS:
+        return "Error: that call is too large to ask a person to approve. Split it into smaller ones.", None
+    if is_mail_send(name):
+        return run_queue_mail(agent_id, name, args, db, interactive, turn)
+    if name in GH_PUSHES:
+        return run_queue_push(agent_id, name, args, db, interactive, turn)
+    return run_queue_write(agent_id, name, args, jira_key, repo, db, interactive, turn)
