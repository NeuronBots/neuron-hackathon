+def _room(agent_id: str, db: Session, interactive: bool, turn: dict | None) -> Optional[str]:
+    """The board's limit on pending decisions, which binds a bot on its own only: a person in the chat is deciding right now, and a call
+    that joins this turn's task adds none."""
+    return None if interactive or (turn or {}).get("group") else decision_cap_msg(agent_id, db)
