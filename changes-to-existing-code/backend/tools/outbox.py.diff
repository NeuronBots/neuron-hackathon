+def is_outward(name: str) -> bool:
+    """A write through a connected account (Jira, Confluence, GitHub, Gmail). Like tools.writes.is_write, anything not plainly a read counts,
+    so a tool nobody has classified yet is held instead of run. Local tools (documents, board, calendar, web) are not outward."""
+    from integrations.atlassian_mcp import owns as atlassian_owns
+    from integrations.github_mcp import owns as github_owns
+    from integrations.gmail_mcp import owns as gmail_owns
+
+    return is_write(name) and (gmail_owns(name) or github_owns(name) or atlassian_owns(name) or name in _LOCAL_OUTWARD)
+
