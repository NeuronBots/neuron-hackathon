+async def _missing(provider: str) -> str:
+    """An error for the bot when this shared chat's requester has not connected `provider`; empty when the call may go ahead."""
+    try:
+        await connections.require(provider)
+    except connections.MissingToken as exc:
+        return f"Error: {exc}"
+    return ""
+
+
+async def _jira_local(name: str, fn, arguments: dict, jira_key: str, agent_id: str) -> str:
+    """The sprint and attachment tools built on raw Atlassian calls: the requester's own connection only, a write waits for their Proceed, and a reader needs access to the project."""
+    if err := await _missing("atlassian"):
+        return err
+    if held := hold_write("atlassian", name, arguments, jira_key, "", agent_id):
+        return held
+    try:
+        return await guard("atlassian", await fn(arguments, jira_key), jira_key)
+    except Exception as exc:
+        return f"Error: {exc}"
+
+
