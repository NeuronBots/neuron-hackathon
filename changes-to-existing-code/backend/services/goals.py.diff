+def refresh_project(project_id: str, user_id: str) -> None:
+    """The project changed shape (a build started or ended): rebuild every bot's goals now so each one carries its part of it. Never raises; blocking."""
+    from concurrent.futures import ThreadPoolExecutor
+    from core.database import SessionLocal
+    from core.usage import reset_usage_user, set_usage_user
+
+    db = SessionLocal()
+    try:
+        ids = [a for (a,) in db.query(Agent.id).filter(Agent.project_id == project_id)]
+    finally:
+        db.close()
+
+    def one(agent_id: str) -> None:
+        token = set_usage_user(user_id, project_id)
+        try:
+            refresh_if_stale(agent_id, user_id, force=True)
+        finally:
+            reset_usage_user(token)
+
+    with ThreadPoolExecutor(max_workers=4) as pool:
+        list(pool.map(one, ids))
