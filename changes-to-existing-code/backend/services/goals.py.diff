+def _project_block(agent: Agent, db: Session) -> str:
+    """The project this bot is part of and what the team has produced for it: the plan, the build, the reports."""
+    from core.models import DocumentRecord
+    project = db.get(Project, agent.project_id)
+    made = db.query(DocumentRecord.title, DocumentRecord.filename).filter(DocumentRecord.project_id == agent.project_id).order_by(DocumentRecord.created_at.desc()).limit(10).all()
+    lines = [f"Project: {project.name}. Stated goal: {(project.goal or '(none)')[:600]}. Summary: {(project.summary or '')[:800]}"]
+    if made:
+        lines.append("What the team produced so far, newest first:\n" + "\n".join(f"- {t or f}" for t, f in made))
+    return "\n".join(lines)
+
