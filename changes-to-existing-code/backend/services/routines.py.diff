+def add_for_order(agent_id: str, title: str, instruction: str, bot: str = "") -> str:
+    """Create an order routine for this bot, or for the teammate named in `bot`. Blocking; what the bot is told comes back."""
+    from core.database import SessionLocal
+    from core.models import Agent, Routine
+    from core.usage import current_user
+
+    title, instruction = title.strip()[:120], instruction.strip()[:4000]
+    if not title or not instruction:
+        return "Error: give the routine a title and the steps."
+    db = SessionLocal()
+    try:
+        me = db.get(Agent, agent_id)
+        if me is None or not current_user():
+            return "Error: no person to run the routine for."
+        target = next((a for a in db.query(Agent).filter(Agent.project_id == me.project_id) if bot and a.name.lower() == bot.strip().lower()), None) if bot else me
+        if target is None:
+            return f"Error: no teammate named {bot}."
+        db.add(Routine(agent_id=target.id, user_id=current_user(), title=title, instruction=instruction, schedule=json.dumps({"kind": ON_ORDER, "tz": ""}), next_run_at=None))
+        db.commit()
+        return f"Added the routine “{title}” for {target.name}: it runs every time an order comes in from the website."
+    finally:
+        db.close()
+
