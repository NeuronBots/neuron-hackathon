+def add_for_order(agent_id: str, title: str, instruction: str, bot: str = "") -> str:
+    """Create an order routine for this bot, or for the teammate named in `bot`. Blocking; what the bot is told comes back."""
+    from core.database import SessionLocal
+    from core.models import Agent, Routine
+    from core.usage import current_user
+
+    title, instruction = title.strip()[:120], instruction.strip()[:4000]
+    if not title or not instruction:
+        return "Error: give the routine a title and the steps."
+    db = SessionLocal()
+    try:
+        me = db.get(Agent, agent_id)
+        if me is None or not current_user():
+            return "Error: no person to run the routine for."
+        target = next((a for a in db.query(Agent).filter(Agent.project_id == me.project_id) if bot and a.name.lower() == bot.strip().lower()), None) if bot else me
+        if target is None:
+            return f"Error: no teammate named {bot}."
+        db.add(Routine(agent_id=target.id, user_id=current_user(), title=title, instruction=instruction, schedule=json.dumps({"kind": ON_ORDER, "tz": ""}), next_run_at=None))
+        db.commit()
+        return f"Added the routine “{title}” for {target.name}: it runs every time an order comes in from the website."
+    finally:
+        db.close()
+
+
+def _order_rows(db, project_id: str) -> list:
+    from core.models import Agent, Routine
+    return (db.query(Routine, Agent).join(Agent, Agent.id == Routine.agent_id)
+            .filter(Agent.project_id == project_id, Routine.schedule.like('%"on_order"%')).order_by(Routine.created_at).all())
+
+
+def existing_for_order(project_id: str) -> str:
+    """The project's order routines as text a bot can read before it refines them, or ''."""
+    from core.database import SessionLocal
+
+    db = SessionLocal()
+    try:
+        return "\n".join(f"- {a.name} · “{r.title}”{'' if r.enabled else ' (off)'}: {r.instruction}" for r, a in _order_rows(db, project_id))
+    finally:
+        db.close()
+
+
+def update_for_order(agent_id: str, title: str, new_title: str = "", instruction: str = "", enabled: bool | None = None, bot: str = "") -> str:
+    """Change an existing order routine, found by its title (and the bot's name when two share a title). Blocking; what the bot is told comes back."""
+    from core.database import SessionLocal
+    from core.models import Agent
+
+    db = SessionLocal()
+    try:
+        me = db.get(Agent, agent_id)
+        if me is None:
+            return "Error: no such bot."
+        rows = [(r, a) for r, a in _order_rows(db, me.project_id)
+                if r.title.lower() == title.strip().lower() and (not bot or a.name.lower() == bot.strip().lower())]
+        if not rows:
+            return f"Error: no order routine called “{title}”. The existing ones:\n{existing_for_order(me.project_id) or '(none)'}"
+        if len(rows) > 1:
+            return f"Error: {len(rows)} order routines are called “{title}”: say which bot's with `bot`."
+        row, owner = rows[0]
+        if new_title.strip():
+            row.title = new_title.strip()[:120]
+        if instruction.strip():
+            row.instruction = instruction.strip()[:4000]
+        if enabled is not None:
+            row.enabled = enabled
+        db.commit()
+        return f"Updated the routine “{row.title}” of {owner.name}: it runs {'every time an order comes in from the website' if row.enabled else 'never until switched on again'}."
+    finally:
+        db.close()
+
+
