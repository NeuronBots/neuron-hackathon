+# ElevenLabs conversation ids are short; this bound also keeps "conv:<id>" inside the 64-character request_id.
+_CONV_ID = re.compile(r"[A-Za-z0-9_-]{8,59}")
+_GIVE_UP_SECS = 7 * 24 * 3600  # asked about every round until then; a call still unbilled after this is dropped
+_NO_CALL_SECS = 30 * 60  # a started call with no conversation at all after this never connected, so there is nothing to bill
+_ELEVEN = "https://api.elevenlabs.io/v1/convai"
+
+
+def _ask(path: str, **params) -> dict | None:
+    """One read from ElevenLabs as JSON, or None when it could not be had (not configured, 429/5xx, a network error, an odd reply)."""
+    key = os.getenv("ELEVENLABS_API_KEY")
+    if not key:
+        return None
+    try:
+        resp = httpx.get(f"{_ELEVEN}/{path}", params=params, headers={"xi-api-key": key}, timeout=10)
+        if resp.status_code == 404:
+            return {}  # nothing there (yet): a conversation whose signed URL has not been used
+        resp.raise_for_status()
+        body = resp.json()
+    except (httpx.HTTPError, ValueError):
+        return None
+    return body if isinstance(body, dict) else None
+
+
+def conversations_for(call) -> tuple[list[tuple[str, float]], bool] | None:
+    """(finished conversations as (id, seconds), whether any is still running or being processed) for one call, from ElevenLabs'
+    record, or None when ElevenLabs could not be asked: try again later. A call bills only the conversation its signed URL was
+    issued for; one without a recorded conversation (the id was not in the URL) is found by the user id the browser gave it."""
+    agent_id = os.getenv("ELEVENLABS_AGENT_ID")
+    if not agent_id:
+        return None
+    if call.conversation_id:
+        body = _ask(f"conversations/{call.conversation_id}")
+        if body is None:
+            return None
+        items = [{**body, "conversation_id": call.conversation_id, "call_duration_secs": (body.get("metadata") or {}).get("call_duration_secs")}] if body.get("agent_id") == agent_id else []
+    else:
+        body = _ask("conversations", agent_id=agent_id, user_id=call.id, page_size=10)
+        items = None if body is None else body.get("conversations")
+    if not isinstance(items, list):
+        return None
+    done, unfinished = [], False
+    for item in items:
+        if not isinstance(item, dict):
+            continue
+        cid, secs = item.get("conversation_id"), item.get("call_duration_secs")
+        if item.get("status") == "failed":
+            continue
+        if item.get("status") != "done":  # a partial duration is never billed: the real one is read once the call is done
+            unfinished = True
+        elif isinstance(cid, str) and _CONV_ID.fullmatch(cid) and isinstance(secs, (int, float)) and secs >= 0:
+            done.append((cid, float(secs)))
+    return done, unfinished
+
+
+def settle(user_id: str | None = None, db=None) -> int:
+    """Bill finished calls from ElevenLabs' record of them, for one person or (no user_id) for everyone. Returns how many calls are
+    still waiting on it. The browser has no part in this: it only ever says that a call happened."""
+    from datetime import datetime
+
+    from core import jsonl
+    from core.database import SessionLocal
+    from core.models import VoiceCall
+    from core.usage import record_call_usage
+
+    session = db or SessionLocal()
+    try:
+        now, waiting = datetime.utcnow(), 0
+        query = session.query(VoiceCall).filter(VoiceCall.settled.is_(False))
+        for call in (query.filter(VoiceCall.user_id == user_id) if user_id else query.order_by(VoiceCall.started_at).limit(200)).all():
+            age = (now - call.started_at).total_seconds()
+            found = conversations_for(call)
+            if found is not None:
+                done, unfinished = found
+                for cid, secs in done:
+                    record_call_usage(session, call.user_id, seconds=secs, agent_id=call.agent_id, conversation_id=cid, project_id=call.project_id)
+                if done and not unfinished:
+                    call.settled = True
+                    continue
+                if not done and not unfinished and age >= _NO_CALL_SECS:
+                    call.settled = True  # ElevenLabs has nothing for it: it never connected
+                    continue
+            if age > _GIVE_UP_SECS:  # asked above first; only a call ElevenLabs still cannot show us after this long is dropped
+                call.settled = True
+                jsonl.emit("voice.call.abandoned", user_id=call.user_id, call_id=call.id)
+                continue
+            waiting += 1
+        session.commit()
+        return waiting
+    except Exception:
+        session.rollback()
+        raise
+    finally:
+        if db is None:
+            session.close()
+
+
+async def sweeper() -> None:
+    """Settle every person's waiting calls on a timer, so billing never depends on that person starting another call."""
+    import asyncio
+
+    from core import jsonl
+
+    interval = int(os.getenv("VOICE_SETTLE_SECONDS", "300") or 0)
+    if interval <= 0:
+        return
+    await asyncio.sleep(60)  # let the server finish starting
+    while True:
+        try:
+            await asyncio.to_thread(settle)
+        except Exception as exc:
+            jsonl.emit("voice.sweep_failed", error=type(exc).__name__, message=str(exc)[:200])
+        await asyncio.sleep(interval)
+
+
+_settling: set[str] = set()  # people with a settle loop running: one at a time each, so repeated saves cannot pile up
+_settling_lock = threading.Lock()
+
+
+def settle_soon(user_id: str, tries: int = 6, wait: float = 5.0) -> None:
+    """Background task: settle, and look again a few times, since ElevenLabs finishes a conversation a little after hang-up.
+    Whatever is still waiting is picked up by the next call start or save."""
+    from core import jsonl
+
+    with _settling_lock:
+        if user_id in _settling:
+            return
+        _settling.add(user_id)
+    try:
+        for attempt in range(tries):
+            if not settle(user_id):
+                return
+            if attempt < tries - 1:
+                time.sleep(wait)
+    except Exception as exc:  # a background task has nobody to tell; the log is where this shows
+        jsonl.emit("voice.settle_failed", user_id=user_id, error=type(exc).__name__, message=str(exc)[:200])
+    finally:
+        with _settling_lock:
+            _settling.discard(user_id)
+
+
