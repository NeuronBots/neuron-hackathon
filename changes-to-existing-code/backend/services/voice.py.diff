@@ -107,0 +107,101 @@ def token_ok(token: str, user_id: str, agent_id: str) -> bool:
+# ElevenLabs conversation ids are short; this bound also keeps "conv:<id>" inside the 64-character request_id.
+_CONV_ID = re.compile(r"[A-Za-z0-9_-]{8,59}")
+_GIVE_UP_SECS = 24 * 3600  # a call still unsettled after this is dropped
+_NO_CALL_SECS = 30 * 60  # a started call with no conversation at all after this never connected, so there is nothing to bill
+
+
+def conversations_for(call_id: str) -> tuple[list[tuple[str, float]], bool] | None:
+    """(finished conversations as (id, seconds), whether any is still running or being processed) for one call, from ElevenLabs'
+    record, or None when ElevenLabs could not be asked (not configured, 404/429/5xx, a network error, an odd reply): try again later."""
+    key, agent_id = os.getenv("ELEVENLABS_API_KEY"), os.getenv("ELEVENLABS_AGENT_ID")
+    if not key or not agent_id:
+        return None
+    try:
+        resp = httpx.get("https://api.elevenlabs.io/v1/convai/conversations",
+                         params={"agent_id": agent_id, "user_id": call_id, "page_size": 10}, headers={"xi-api-key": key}, timeout=10)
+        resp.raise_for_status()
+        items = resp.json().get("conversations")
+    except (httpx.HTTPError, ValueError, AttributeError):
+        return None
+    if not isinstance(items, list):
+        return None
+    done, unfinished = [], False
+    for item in items:
+        if not isinstance(item, dict):
+            continue
+        cid, secs = item.get("conversation_id"), item.get("call_duration_secs")
+        if item.get("status") == "failed":
+            continue
+        if item.get("status") != "done":  # a partial duration is never billed: the real one is read once the call is done
+            unfinished = True
+        elif isinstance(cid, str) and _CONV_ID.fullmatch(cid) and isinstance(secs, (int, float)) and secs >= 0:
+            done.append((cid, float(secs)))
+    return done, unfinished
+
+
+def settle(user_id: str, db=None) -> int:
+    """Bill this person's finished calls from ElevenLabs' record of them. Returns how many calls are still waiting on it.
+    The browser has no part in this: it only ever says that a call happened."""
+    from datetime import datetime, timedelta
+
+    from core import jsonl
+    from core.database import SessionLocal
+    from core.models import VoiceCall
+    from core.usage import record_call_usage
+
+    session = db or SessionLocal()
+    try:
+        now, waiting = datetime.utcnow(), 0
+        for call in session.query(VoiceCall).filter(VoiceCall.user_id == user_id, VoiceCall.settled.is_(False)).all():
+            age = (now - call.started_at).total_seconds()
+            if age > _GIVE_UP_SECS:
+                call.settled = True
+                jsonl.emit("voice.call.abandoned", user_id=user_id, call_id=call.id)
+                continue
+            found = conversations_for(call.id)
+            if found is None:
+                waiting += 1
+                continue
+            done, unfinished = found
+            for cid, secs in done:
+                record_call_usage(session, user_id, seconds=secs, agent_id=call.agent_id, conversation_id=cid, project_id=call.project_id)
+            if unfinished or (not done and age < _NO_CALL_SECS):
+                waiting += 1
+            else:
+                call.settled = True
+        session.commit()
+        return waiting
+    except Exception:
+        session.rollback()
+        raise
+    finally:
+        if db is None:
+            session.close()
+
+
+_settling: set[str] = set()  # people with a settle loop running: one at a time each, so repeated saves cannot pile up
+_settling_lock = threading.Lock()
+
+
+def settle_soon(user_id: str, tries: int = 6, wait: float = 5.0) -> None:
+    """Background task: settle, and look again a few times, since ElevenLabs finishes a conversation a little after hang-up.
+    Whatever is still waiting is picked up by the next call start or save."""
+    from core import jsonl
+
+    with _settling_lock:
+        if user_id in _settling:
+            return
+        _settling.add(user_id)
+    try:
+        for attempt in range(tries):
+            if not settle(user_id):
+                return
+            if attempt < tries - 1:
+                time.sleep(wait)
+    except Exception as exc:  # a background task has nobody to tell; the log is where this shows
+        jsonl.emit("voice.settle_failed", user_id=user_id, error=type(exc).__name__, message=str(exc)[:200])
+    finally:
+        with _settling_lock:
+            _settling.discard(user_id)
+
+
