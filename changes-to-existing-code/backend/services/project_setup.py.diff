+_API = "https://api.github.com"
+_REPO_NAME = re.compile(r"^[A-Za-z0-9._-]{1,100}$")
+
+
+def _headers(token: str) -> dict:
+    return {"Authorization": "Bearer " + token, "Accept": "application/vnd.github+json"}
+
+
+async def repo_owners(token: str) -> list[dict]:
+    """Where this person may put a new repository: their own account first, then their organisations."""
+    try:
+        async with httpx.AsyncClient(timeout=20) as client:
+            me = await client.get(f"{_API}/user", headers=_headers(token))
+            orgs = await client.get(f"{_API}/user/orgs", params={"per_page": 100}, headers=_headers(token))
+    except httpx.HTTPError as exc:
+        raise RuntimeError("Could not reach GitHub") from exc
+    if me.status_code in (401, 403):
+        raise ValueError("GitHub no longer accepts your connection. Reconnect GitHub in Settings and try again.")
+    if me.status_code != 200 or orgs.status_code not in (200, 403):  # 403: an organisation policy hides the list; their own account still works
+        raise RuntimeError(f"GitHub returned {me.status_code} for your account")
+    found = [{"login": o["login"], "kind": "org"} for o in (orgs.json() if orgs.status_code == 200 else []) if isinstance(o, dict) and o.get("login")]
+    return [{"login": me.json()["login"], "kind": "user"}, *found]
+
+
+async def _target_owner(token: str, owner: str) -> dict:
+    owners = await repo_owners(token)  # only a place the person is a member of; never a name they typed
+    target = next((o for o in owners if o["login"].lower() == owner.strip().lower()), None) if owner.strip() else owners[0]
+    if target is None:
+        raise ValueError("You can only create a repository on your own account or in an organisation you belong to.")
+    return target
+
+
+def _valid_repo_name(name: str) -> str:
+    name = (name or "").strip()
+    if not _REPO_NAME.match(name) or name in (".", "..") or name.endswith(".git"):
+        raise ValueError("Name the repository with letters, numbers, dots, dashes and underscores only.")
+    return name
+
+
+async def check_new_repo(token: str, name: str, owner: str = "", private: bool = True, description: str = "") -> dict:
+    """A dry run of create_repo: every check that can be made without creating anything (the name, the place, and that no repository of that name
+    exists there yet). Raises ValueError with a message meant for the person; otherwise says what would be created."""
+    name = _valid_repo_name(name)
+    target = await _target_owner(token, owner)
+    try:
+        async with httpx.AsyncClient(timeout=30) as client:
+            r = await client.get(f"{_API}/repos/{target['login']}/{name}", headers=_headers(token))
+    except httpx.HTTPError as exc:
+        raise RuntimeError("Could not reach GitHub") from exc
+    if r.status_code == 200:
+        raise ValueError(f"{target['login']}/{name} already exists. Pick another name.")
+    if r.status_code in (401, 403):
+        raise ValueError("GitHub would not let this account look there. Check that GitHub is connected with access to it.")
+    if r.status_code not in (404,):
+        raise RuntimeError(f"GitHub returned {r.status_code} when checking the name")
+    return {"full_name": f"{target['login']}/{name}", "private": bool(private), "description": (description or "").strip()[:350]}
+
+
+async def create_repo(token: str, name: str, owner: str = "", private: bool = True, description: str = "") -> dict:
+    """Create an empty repository (with a README, so it has a first commit) on the person's account or in an organisation they belong to,
+    as them. Raises ValueError with a message meant for the person."""
+    name = _valid_repo_name(name)
+    target = await _target_owner(token, owner)
+    url = f"{_API}/user/repos" if target["kind"] == "user" else f"{_API}/orgs/{target['login']}/repos"
+    body = {"name": name, "description": (description or "").strip()[:350], "private": bool(private), "auto_init": True}
+    try:
+        async with httpx.AsyncClient(timeout=30) as client:
+            r = await client.post(url, json=body, headers=_headers(token))
+    except httpx.HTTPError as exc:
+        raise RuntimeError("Could not reach GitHub") from exc
+    if r.status_code == 422:
+        raise ValueError(f"{target['login']}/{name} already exists or the name is not allowed. Pick another name.")
+    if r.status_code in (401, 403, 404):
+        raise ValueError("GitHub would not let you create a repository there. Check that GitHub is connected with access to it "
+                         "(an organisation may restrict who can create repositories).")
+    if r.status_code != 201:
+        raise RuntimeError(f"GitHub returned {r.status_code} when creating the repository")
+    data = r.json()
+    _own_repo_cache.clear()  # the new repository belongs in the next search
+    return {"full_name": data["full_name"], "description": data.get("description") or "", "language": "", "html_url": data["html_url"], "private": bool(data.get("private"))}
+
